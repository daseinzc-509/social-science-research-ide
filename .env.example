# Safe developer template. Do not put genuine keys in tracked files.
# The Desktop Settings screen saves keys under the current Windows user,
# encrypted with DPAPI (instead of writing them into this project directory).
# For headless development, a local ignored .env is still supported.

SRA_LITE_API_KEY=
SRA_LITE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
SRA_LITE_MODEL=doubao-seed-2.1-lite

SRA_PRO_API_KEY=
SRA_PRO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
SRA_PRO_MODEL=doubao-seed-2.1-pro

# Optional custom local library path; leave commented to use SRA per-user data.
# SRA_DATA_DIR=
