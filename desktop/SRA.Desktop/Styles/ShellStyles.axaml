<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- One unified, theme-aware application title bar. -->
  <Style Selector="Border.unified-titlebar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="Button.chrome-nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.chrome-nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Button.chrome-nav.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.chrome-nav.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
  </Style>
  <Style Selector="Button.focus-toggle">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>
  <Style Selector="Button.chrome-import">
    <Setter Property="MinHeight" Value="31"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Button.window-caption">
    <Setter Property="Width" Value="43"/>
    <Setter Property="MinWidth" Value="43"/>
    <Setter Property="Height" Value="54"/>
    <Setter Property="MinHeight" Value="54"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style Selector="Button.window-caption:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Button.window-caption.close:pointerover">
    <Setter Property="Background" Value="#D84E62"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.window-caption Path">
    <Setter Property="Stroke" Value="{DynamicResource InkSecondaryBrush}"/>
  </Style>
  <Style Selector="Button.window-caption:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Button.window-caption.close:pointerover Path">
    <Setter Property="Stroke" Value="White"/>
  </Style>
  <Style Selector="Button.window-caption.close:pressed">
    <Setter Property="Background" Value="#B9364B"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Border.sidebar-pane">
    <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Button.sidebar-nav">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.sidebar-nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button.sidebar-nav.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.sidebar-nav.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Border.workspace-header">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.workspace-surface">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.page-header">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Border.metric-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="TabControl.paper-tabs">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
</Styles>
