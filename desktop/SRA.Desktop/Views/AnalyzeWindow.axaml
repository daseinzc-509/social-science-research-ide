<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SRA.Desktop.Views.AnalyzeWindow"
        Title="分析论文"
        Width="640"
        Height="520"
        MinWidth="560"
        MinHeight="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="page-header" Padding="24,18">
      <StackPanel Spacing="4">
        <TextBlock Text="分析论文" Classes="h1" />
        <TextBlock Text="配置研究关注语境、相邻文章排除边界与缓存策略。" Classes="muted" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20" Spacing="16">
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Text="研究关注（可选）" FontWeight="SemiBold" FontSize="13" />
              <TextBox x:Name="ResearchContextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112"
                       PlaceholderText="例如：我关心大语言模型如何影响社会互动或制度信任" />
              <TextBlock Text="只影响相关性与阅读建议，不改变论文基础事实与原文溯源提取。" Classes="tertiary" FontSize="11" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="在此文本后排除（可选）" FontWeight="SemiBold" FontSize="13" />
              <TextBox x:Name="ExcludeAfterBox" PlaceholderText="用于一个 PDF 含相邻文章或期刊尾页的情况" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="soft-card" Padding="14,12">
          <CheckBox x:Name="ForceCheckBox" Content="忽略缓存，重新调用 Lite + Pro（可能产生新的 API 费用，通常无需勾选）" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
        <Button Content="取消" Classes="secondary" Click="Cancel_Click" />
        <Button Content="开始分析" Classes="primary" Click="Run_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
