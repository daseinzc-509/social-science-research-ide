<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SRA.Desktop.ViewModels"
        xmlns:models="using:SRA.Desktop.Models"
        xmlns:controls="using:SRA.Desktop.Controls"
        x:Class="SRA.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Social Science Research IDE"
        Icon="/Assets/sra.ico"
        Width="1560"
        Height="960"
        MinWidth="1080"
        MinHeight="720"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="54"
        CanResize="True"
        WindowStartupLocation="CenterScreen">
  <!-- The only title bar is this 54 px application chrome. Windows does not draw a second one. -->
  <Grid RowDefinitions="54,*,26">
    <Border Grid.Row="0" Classes="unified-titlebar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Stretch">
        <Border Grid.Column="0" Padding="13,0,18,0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="9" ClipToBounds="True">
              <Image Source="/Assets/sra-titlebar.png" Stretch="UniformToFill"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Social Science Research IDE" FontSize="13"
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Button x:Name="PapersNav" Content="论文库" Classes="chrome-nav selected" Click="PapersNav_Click" />
          <Button x:Name="TasksNav" Content="任务" Classes="chrome-nav" Click="TasksNav_Click" />
          <Button x:Name="HealthNav" Content="数据" Classes="chrome-nav" Click="HealthNav_Click" />
          <Button x:Name="SettingsNav" Content="设置" Classes="chrome-nav" Click="SettingsNav_Click" />
        </StackPanel>

        <Border Grid.Column="2" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar"/>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Content="＋ 导入 PDF" Classes="primary chrome-import" ToolTip.Tip="导入 PDF">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="导入单个 PDF" Click="ImportPdf_Click" />
                <MenuItem Header="批量选择 PDF" Click="BatchImport_Click" />
                <MenuItem Header="导入 PDF 文件夹" Click="FolderImport_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Classes="window-caption" ToolTip.Tip="最小化" Click="MinimizeWindow_Click">
            <!-- Unlike a horizontal Path (zero-height bounds), this remains visible at every DPI. -->
            <Border Width="15" Height="2" CornerRadius="1"
                    Background="{DynamicResource InkBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button Classes="window-caption" ToolTip.Tip="最大化 / 还原" Click="ToggleMaximizeWindow_Click">
            <Path Data="M 2,2 L 12,2 L 12,12 L 2,12 Z" Width="14" Height="14" Stretch="Uniform"
                  StrokeThickness="1.35"
                  StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button Classes="window-caption close" ToolTip.Tip="关闭窗口" Click="CloseWindow_Click">
            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Width="14" Height="14" Stretch="Uniform"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceBody" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="SidebarPane" Grid.Column="0" Classes="sidebar-pane">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Grid.Row="0" Margin="18,22,18,14" Spacing="7">
            <TextBlock Text="文献库" Classes="h1"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="badge-accent"><TextBlock Text="论文" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" /></Border>
              <Border Classes="badge"><TextBlock Text="书籍 · 即将支持" Classes="tertiary" FontSize="9"/></Border>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="14,0,14,12" Spacing="10">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="搜索论文、作者、期刊…"/>
            <Grid ColumnDefinitions="*,Auto" Margin="6,3,5,0">
              <TextBlock Text="全部论文" FontWeight="SemiBold" FontSize="10"/>
              <TextBlock Grid.Column="1" Text="{Binding LibrarySummary}" Classes="tertiary" FontSize="9"/>
            </Grid>
          </StackPanel>
          <Grid Grid.Row="2" Margin="9,0,9,14">
            <ListBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}"
                     Classes="library-list" SelectionMode="Single">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:PaperSummary">
                  <Border Classes="paper-list-card" Padding="12,11">
                    <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                      <Border Grid.Column="0" Width="3" Classes="paper-selection-marker" CornerRadius="99"/>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="2" LineHeight="19"/>
                        <TextBlock Text="{Binding AuthorLine}" Classes="muted" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding StatusLine}" Classes="tertiary" FontSize="10" VerticalAlignment="Center"/>
                          <Border Grid.Column="1" Classes="badge-accent" IsVisible="{Binding HasCard}" VerticalAlignment="Center">
                            <TextBlock Text="已分析" Foreground="{DynamicResource AccentBrush}" FontSize="9" VerticalAlignment="Center"/>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding IsLibraryEmpty}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" MaxWidth="240" Spacing="8">
              <TextBlock Text="没有匹配的论文" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="导入 PDF，或调整搜索条件。" Classes="muted"
                         HorizontalAlignment="Center" TextAlignment="Center"/>
              <Button Content="导入 PDF" Classes="primary compact" Click="ImportPdf_Click" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <!-- Papers -->
      <DockPanel x:Name="PapersPage" Grid.Column="1" LastChildFill="True">
<Border DockPanel.Dock="Right" Width="282" Classes="inspector-pane" IsVisible="{Binding ShowInspector}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,20,18,22" Spacing="16">
            <StackPanel Spacing="3">
              <TextBlock Text="研究画像" Classes="h2" />
              <TextBlock Text="依据已提取的论文结构" Classes="tertiary" FontSize="11" />
            </StackPanel>

            <Border Classes="inspector-section" Padding="13">
              <StackPanel Spacing="9">
                <StackPanel Spacing="3"><TextBlock Text="STUDY TYPE" Classes="eyebrow"/><TextBlock Text="{Binding SelectedStudyType}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/></StackPanel>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" />
                <StackPanel Spacing="3"><TextBlock Text="METHOD" Classes="eyebrow"/><TextBlock Text="{Binding SelectedStudyMethod}" TextWrapping="Wrap" FontSize="12" LineHeight="18" MaxLines="4" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Spacing="3"><TextBlock Text="IDENTIFICATION" Classes="eyebrow"/><TextBlock Text="{Binding SelectedIdentification}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="18" MaxLines="4" TextTrimming="CharacterEllipsis"/></StackPanel>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <Border Grid.Column="0" Classes="metric-cell" Padding="9"><StackPanel Spacing="1"><TextBlock Text="FACTS" Classes="eyebrow"/><TextBlock Text="{Binding SelectedFactsCount}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="1" Classes="metric-cell" Padding="9"><StackPanel Spacing="1"><TextBlock Text="EVIDENCE" Classes="eyebrow"/><TextBlock Text="{Binding SelectedEvidenceCount}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="2" Classes="metric-cell" Padding="9"><StackPanel Spacing="1"><TextBlock Text="REVIEW" Classes="eyebrow"/><TextBlock Text="{Binding SelectedReviewsCount}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Text="审读计划" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ReviewPlanText}" Classes="muted" TextWrapping="Wrap" FontSize="12" LineHeight="19" MaxLines="5" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" />

            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="运行状态" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding JobStage}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
              </Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding JobProgress}" IsIndeterminate="{Binding JobIndeterminate}" Height="4" />
              <TextBlock Text="{Binding SelectedParseStatus}" Classes="tertiary" TextWrapping="Wrap" FontSize="11" />
              <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" FontSize="11" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" />

            <StackPanel Spacing="7">
              <TextBlock Text="来源" FontWeight="SemiBold" />
              <TextBlock Text="作者、AI 与个人笔记分别标记来源。" Classes="muted" TextWrapping="Wrap" FontSize="11" />
              <WrapPanel ItemSpacing="5" LineSpacing="5">
                <Border Background="{DynamicResource BlueSoftBrush}" CornerRadius="99" Padding="7,3"><TextBlock Text="AUTHOR" Foreground="{DynamicResource BlueInkBrush}" FontSize="8" FontWeight="SemiBold"/></Border>
                <Border Background="{DynamicResource PurpleSoftBrush}" CornerRadius="99" Padding="7,3"><TextBlock Text="AI REVIEW" Foreground="{DynamicResource PurpleInkBrush}" FontSize="8" FontWeight="SemiBold"/></Border>
                <Border Classes="badge"><TextBlock Text="MY NOTE" Classes="muted" FontSize="8" FontWeight="SemiBold"/></Border>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
<Grid RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
        <Border Grid.Row="0" Classes="workspace-header" Padding="26,18,26,18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Grid.Column="0" Spacing="6">
              <WrapPanel ItemSpacing="7" LineSpacing="5">
                <TextBlock Text="PAPER" Classes="eyebrow" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="•" Classes="tertiary" FontSize="9" />
                <TextBlock Text="{Binding SelectedAnalysisState}" Classes="tertiary" FontSize="9" />
                <Border IsVisible="{Binding HasManualMetadata}" Background="{DynamicResource AmberSoftBrush}" CornerRadius="99" Padding="7,2">
                  <TextBlock Text="手动修订" Foreground="{DynamicResource AmberInkBrush}" FontSize="8" FontWeight="SemiBold" />
                </Border>
              </WrapPanel>
              <TextBlock Text="{Binding SelectedTitle}" Classes="document-title" TextWrapping="Wrap" MaxLines="2" />
              <TextBlock Text="{Binding SelectedSubtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,0,0">
              <Button Content="{Binding AnalyzeButtonText}" Classes="primary" IsEnabled="{Binding CanRunPaperActions}" Click="Analyze_Click" />
              <Button Content="打开 PDF" Classes="secondary" IsEnabled="{Binding HasSelection}" Click="OpenPdf_Click" />
              <Button Content="专注阅读" Classes="ghost focus-toggle" ToolTip.Tip="显示或收起右侧研究画像" Click="ToggleInspector_Click" />
              <Button Content="•••" Classes="secondary icon" IsEnabled="{Binding HasSelection}" ToolTip.Tip="更多论文操作">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="编辑元数据" Click="EditMetadata_Click" />
                    <MenuItem Header="重建 PDF 解析" Click="Reparse_Click" />
                    <MenuItem Header="提取参考文献" Click="ExtractReferences_Click" />
                    <MenuItem Header="-" />
                    <MenuItem Header="导出 Paper Card JSON" Click="ExportCard_Click" />
                    <MenuItem Header="导出精读报告" Click="ExportReading_Click" />
                    <MenuItem Header="导出解析文本" Click="ExportText_Click" />
                    <MenuItem Header="导出 Zotero BibTeX" Click="ExportBibtex_Click" />
                    <MenuItem Header="-" />
                    <MenuItem Header="删除论文" Click="DeletePaper_Click" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="workspace-surface" Margin="12,12,12,14">
          <TabControl Classes="paper-tabs">
            <!-- Product focus: deep reading first -->
            <TabItem Header="精读">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,30,30,50" Spacing="34" MaxWidth="910" HorizontalAlignment="Center">
                  <StackPanel Spacing="12">
                    <TextBlock Text="论文定位" Classes="section-title" />
                    <Border Classes="reading-lead" Padding="24,22">
                      <TextBlock Text="{Binding AbstractText}" TextWrapping="Wrap" FontSize="14" LineHeight="25" />
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="研究设计画像" Classes="section-title" />
                      <TextBlock Grid.Column="1" Text="STUDY PROFILE" Classes="eyebrow" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9">
                      <Border Grid.Column="0" Classes="design-cell" Padding="13">
                        <StackPanel Spacing="4"><TextBlock Text="研究类型" Classes="eyebrow"/><TextBlock Text="{Binding SelectedStudyType}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/></StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="design-cell" Padding="13">
                        <StackPanel Spacing="4"><TextBlock Text="方法" Classes="eyebrow"/><TextBlock Text="{Binding SelectedStudyMethod}" TextWrapping="Wrap"/></StackPanel>
                      </Border>
                      <Border Grid.Column="2" Classes="design-cell" Padding="13">
                        <StackPanel Spacing="4"><TextBlock Text="识别 / 推断策略" Classes="eyebrow"/><TextBlock Text="{Binding SelectedIdentification}" TextWrapping="Wrap"/></StackPanel>
                      </Border>
                    </Grid>
                    <Border Classes="reading-lead" Padding="13,10" IsVisible="{Binding HasStudyRationale}">
                      <TextBlock Text="{Binding StudyRationale}" Classes="muted" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="9"><TextBlock Text="研究问题" Classes="section-title"/><ItemsControl ItemsSource="{Binding ResearchQuestions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="理论与概念" Classes="section-title"/><ItemsControl ItemsSource="{Binding TheoryConcepts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="研究设计" Classes="section-title"/><ItemsControl ItemsSource="{Binding ResearchDesignClaims}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="核心发现" Classes="section-title"/><ItemsControl ItemsSource="{Binding MajorFindings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="作者解释 / 机制" Classes="section-title"/><ItemsControl ItemsSource="{Binding AuthorExplanations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="方法学审读" Classes="section-title"/><ItemsControl ItemsSource="{Binding AnalysisClaims}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="11"><TextBlock Text="作者自述局限" Classes="section-title"/><ItemsControl ItemsSource="{Binding AuthorLimitations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="11"><TextBlock Text="AI 发现局限" Classes="section-title"/><ItemsControl ItemsSource="{Binding AiLimitations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="阅读建议" Classes="section-title"/><ItemsControl ItemsSource="{Binding ReadingRecommendations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="概览">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,28,30,45" Spacing="24">
                  <Border Background="{DynamicResource AmberSoftBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding HasWarnings}">
                    <TextBlock Text="{Binding WarningsText}" Foreground="{DynamicResource AmberInkBrush}" TextWrapping="Wrap" FontSize="11" />
                  </Border>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="card" Padding="16">
                      <StackPanel Spacing="11">
                        <TextBlock Text="书目信息" Classes="section-title" />
                        <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                          <TextBlock Grid.Row="0" Text="题名" Classes="eyebrow"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MetadataTitle}" TextWrapping="Wrap"/>
                          <TextBlock Grid.Row="1" Text="作者" Classes="eyebrow"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MetadataAuthors}" TextWrapping="Wrap"/>
                          <TextBlock Grid.Row="2" Text="期刊" Classes="eyebrow"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MetadataJournal}" TextWrapping="Wrap"/>
                          <TextBlock Grid.Row="3" Text="年份" Classes="eyebrow"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MetadataYear}"/>
                          <TextBlock Grid.Row="4" Text="卷 / 期 / 页" Classes="eyebrow"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding MetadataVolumeIssue}"/><TextBlock Text="{Binding MetadataPages}" Classes="muted"/></StackPanel>
                          <TextBlock Grid.Row="5" Text="DOI" Classes="eyebrow"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MetadataDoi}" TextWrapping="Wrap"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Padding="16">
                      <StackPanel Spacing="10">
                        <TextBlock Text="摘要" Classes="section-title" />
                        <TextBlock Text="{Binding AbstractText}" TextWrapping="Wrap" LineHeight="23" FontSize="13" Classes="muted" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <StackPanel Spacing="8">
                    <TextBlock Text="关键词" Classes="section-title" />
                    <ItemsControl ItemsSource="{Binding Keywords}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="badge" Margin="0,0,6,6"><TextBlock Text="{Binding}" Classes="muted" FontSize="10"/></Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="事实证据">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,28,30,40" Spacing="24">
                  <StackPanel Spacing="9"><TextBlock Text="书目信息证据" Classes="section-title"/><ItemsControl ItemsSource="{Binding MetadataClaims}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="基础事实" Classes="section-title"/><ItemsControl ItemsSource="{Binding BasicFacts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="AI 审读">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,28,30,40" Spacing="24">
                  <StackPanel Spacing="9"><TextBlock Text="方法与贡献审读" Classes="section-title"/><ItemsControl ItemsSource="{Binding AnalysisClaims}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="潜在局限" Classes="section-title"/><ItemsControl ItemsSource="{Binding AiLimitations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  <StackPanel Spacing="9"><TextBlock Text="阅读建议" Classes="section-title"/><ItemsControl ItemsSource="{Binding ReadingRecommendations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="参考文献">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" Spacing="13">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3"><TextBlock Text="参考文献" Classes="section-title"/><TextBlock Text="{Binding ReferenceStatusText}" Classes="muted" FontSize="10"/></StackPanel>
                    <Button Grid.Column="1" Content="导出" Classes="secondary compact" IsEnabled="{Binding HasSelection}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="导出 JSON" Click="ExportReferencesJson_Click" />
                          <MenuItem Header="导出 BibTeX" Click="ExportBibtex_Click" />
                          <MenuItem Header="重新提取参考文献" Click="ExtractReferences_Click" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding References}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:ReferenceItem">
                        <Border Classes="card" Padding="13" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Top">
                              <TextBlock Text="{Binding Ordinal}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Classes="muted" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                              <TextBlock Text="{Binding RawText}" TextWrapping="Wrap" />
                              <WrapPanel ItemSpacing="6"><TextBlock Text="{Binding MetaLine}" Classes="tertiary" FontSize="9"/><TextBlock Text="{Binding ParseStatus}" Classes="tertiary" FontSize="9"/></WrapPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="表格">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" Spacing="10">
                  <ItemsControl ItemsSource="{Binding Tables}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:TableItem">
                        <Border Classes="card" Padding="13" Margin="0,0,0,8">
                          <StackPanel Spacing="7">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="PDF p." Classes="eyebrow"/><TextBlock Text="{Binding Page}" Classes="eyebrow"/></StackPanel>
                            <TextBox Text="{Binding DisplayText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="10" Background="Transparent" BorderThickness="0" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="原始 Card">
              <TextBox Text="{Binding RawCardJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       Margin="18" Padding="14" Background="{DynamicResource CodeBrush}" Foreground="#E7EFEC"
                       BorderThickness="0" CornerRadius="8" FontFamily="Consolas" FontSize="10"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </TabItem>

            <TabItem Header="日志">
              <Grid Margin="22" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                  <StackPanel Spacing="2"><TextBlock Text="{Binding JobStage}" Classes="section-title"/><TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="10"/></StackPanel>
                  <ProgressBar Grid.Column="1" Width="180" Height="5" Minimum="0" Maximum="100" Value="{Binding JobProgress}" IsIndeterminate="{Binding JobIndeterminate}" VerticalAlignment="Center" />
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding JobLog}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         Padding="14" Background="{DynamicResource CodeBrush}" Foreground="#D7E9E2" BorderThickness="0" CornerRadius="8" FontFamily="Consolas" FontSize="10" />
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
      </DockPanel>

      <!-- Books -->
      <Grid x:Name="BooksPage" Grid.Column="1" IsVisible="False" Background="{DynamicResource CanvasBrush}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="书籍理解" Classes="display" HorizontalAlignment="Center" />
          <TextBlock Text="这里会成为 Book / Chapter / Reading Session 工作区。v0.1 先保留入口，不伪装成已经完成的功能。" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Projects -->
      <Grid x:Name="ProjectsPage" Grid.Column="1" IsVisible="False" Background="{DynamicResource CanvasBrush}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="研究项目" Classes="display" HorizontalAlignment="Center" />
          <TextBlock Text="后续将承载 Reading List、Evidence Matrix、多论文比较与 Literature Review。" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Tasks / dashboard, now a page instead of a modal -->
      <Grid x:Name="TasksPage" Grid.Column="1" IsVisible="False" RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
        <Border Grid.Row="0" Classes="page-header" Padding="30,24">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4"><TextBlock Text="任务中心" Classes="display"/><TextBlock Text="批量处理、队列状态与最近一次任务输出。" Classes="muted"/></StackPanel>
            <Button Grid.Column="1" Content="刷新" Classes="secondary compact" Click="RefreshDashboard_Click" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="30" MaxWidth="1080" Spacing="18">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="论文" Classes="eyebrow"/><TextBlock Text="{Binding DashboardPapers}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="1" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="已分析" Classes="eyebrow"/><TextBlock Text="{Binding DashboardAnalyzed}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="2" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="待分析" Classes="eyebrow"/><TextBlock Text="{Binding DashboardPending}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="3" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="待复核" Classes="eyebrow"/><TextBlock Text="{Binding DashboardReview}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="4" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="参考文献" Classes="eyebrow"/><TextBlock Text="{Binding DashboardReferences}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="批量工作流" Classes="h2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="分析待处理论文" Classes="primary" Click="BatchAnalyzePage_Click" />
                  <Button Content="批量提取参考文献" Classes="secondary" Click="BatchReferencesPage_Click" />
                </StackPanel>
                <TextBox Text="{Binding DashboardOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240" FontFamily="Consolas" FontSize="10" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Health / maintenance -->
      <Grid x:Name="HealthPage" Grid.Column="1" IsVisible="False" RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
        <Border Grid.Row="0" Classes="page-header" Padding="30,24">
          <StackPanel Spacing="4"><TextBlock Text="数据与健康" Classes="display"/><TextBlock Text="检查 SQLite、PDF 存储、重复记录和模型缓存。" Classes="muted"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="30" MaxWidth="980" Spacing="16">
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Repository Doctor" Classes="h2" />
                <TextBlock Text="快速检查不会重新读取每个 PDF；深度检查会额外验证文件哈希。" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="快速检查" Classes="primary" Click="QuickDoctorPage_Click" />
                  <Button Content="深度检查" Classes="secondary" Click="DeepDoctorPage_Click" />
                  <Button Content="预览缓存清理" Classes="secondary" Click="PreviewPrunePage_Click" />
                  <Button Content="清理旧缓存" Classes="danger" Click="ApplyPrunePage_Click" />
                </StackPanel>
                <TextBox Text="{Binding MaintenanceOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="360" FontFamily="Consolas" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Settings, inspired by Clash-style in-place preference pages -->
      <Grid x:Name="SettingsPage" Grid.Column="1" IsVisible="False" RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
        <Border Grid.Row="0" Classes="page-header" Padding="30,24">
          <StackPanel Spacing="4"><TextBlock Text="设置" Classes="display"/><TextBlock Text="外观、阅读工作区与模型连接。修改后保存在本机。" Classes="muted"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30" MaxWidth="980" Spacing="16">
            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4"><TextBlock Text="外观" Classes="h2"/><TextBlock Text="跟随系统或固定明暗主题。" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="14">
                  <Grid ColumnDefinitions="*,240" ColumnSpacing="20"><StackPanel Spacing="3"><TextBlock Text="主题" FontWeight="SemiBold"/><TextBlock Text="深色 / 浅色 / 跟随 Windows。" Classes="muted" FontSize="10"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode, Mode=TwoWay}"/></Grid>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
                  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="右侧研究画像" FontWeight="SemiBold"/><TextBlock Text="在论文阅读页显示 Inspector。" Classes="muted" FontSize="10"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding ShowInspector}" VerticalAlignment="Center"/></Grid>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4"><TextBlock Text="模型连接" Classes="h2"/><TextBlock Text="Lite 做事实索引，Pro 做独立审读。" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="18">
                  <StackPanel Spacing="9"><TextBlock Text="Lite" FontWeight="SemiBold"/><TextBox Text="{Binding Settings.LiteApiKey}" PasswordChar="●" PlaceholderText="{Binding Settings.LiteKeyHint}"/><TextBox Text="{Binding Settings.LiteApiBaseUrl}" PlaceholderText="Base URL"/><TextBox Text="{Binding Settings.LiteModel}" PlaceholderText="Model"/></StackPanel>
                  <CheckBox IsChecked="{Binding Settings.UseLiteConnection}" Content="Pro 使用与 Lite 相同的 API Key 和 Base URL"/>
                  <StackPanel Spacing="9"><TextBlock Text="Pro" FontWeight="SemiBold"/><TextBox Text="{Binding Settings.ProApiKey}" PasswordChar="●" PlaceholderText="{Binding Settings.ProKeyHint}" IsEnabled="{Binding Settings.IsProConnectionEditable}"/><TextBox Text="{Binding Settings.ProApiBaseUrl}" PlaceholderText="Base URL" IsEnabled="{Binding Settings.IsProConnectionEditable}"/><TextBox Text="{Binding Settings.ProModel}" PlaceholderText="Model"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="保存模型设置" Classes="primary" Click="SaveEmbeddedSettings_Click"/><TextBlock Text="{Binding Settings.StatusText}" Classes="muted" VerticalAlignment="Center"/></StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="更新与安装" Classes="h2"/>
                  <TextBlock Text="检查新版本，并从官方 GitHub Release 安装。" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="3">
                      <TextBlock Text="启动时自动检查更新" FontWeight="SemiBold"/>
                      <TextBlock Text="仅请求公开的版本信息，不上传论文或 API Key。" Classes="muted" FontSize="10"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding CheckForUpdatesAtStartup, Mode=TwoWay}" VerticalAlignment="Center"/>
                  </Grid>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="3">
                      <TextBlock Text="允许预发布版本" FontWeight="SemiBold"/>
                      <TextBlock Text="开启后也会提示 alpha/beta/rc 版本。" Classes="muted" FontSize="10"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="{Binding InstalledDesktopVersion}" Classes="muted" FontSize="11"/>
                  <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" FontSize="11"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="检查更新" Classes="secondary" Click="CheckForUpdates_Click"/>
                    <Button Content="打开发布页面" Classes="secondary" Click="OpenUpdateRelease_Click" IsEnabled="{Binding CanOpenUpdateRelease}"/>
                  </StackPanel>
                  <TextBlock Text="目前采用自动检测 + 用户确认安装。Windows 安装器可正常卸载，卸载默认不删除本人的 PDF、数据库和 API Key。" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Storage management: the paths are returned by the running
                 Python backend; never guess a PDF location from the UI. -->
            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="存储与卸载" Classes="h2"/>
                  <TextBlock Text="准确查看程序、论文库、设置与缓存的位置。" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                  <TextBlock Text="程序安装位置" FontWeight="SemiBold"/>
                  <TextBlock x:Name="InstalledProgramPathText" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  <Button Content="打开程序目录" HorizontalAlignment="Left" Classes="secondary" Click="OpenProgramDir_Click"/>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
                  <TextBlock Text="研究数据：PDF / SQLite / 笔记" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DataStoragePathText" FontSize="11" TextWrapping="Wrap" Classes="muted" Text="正在获取路径..."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开研究库" Classes="secondary" Click="OpenDataDir_Click"/>
                    <Button Content="打开配置目录" Classes="secondary" Click="OpenConfigDir_Click"/>
                  </StackPanel>
                  <TextBlock Text="模型缓存（SRA 管理）" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CacheStoragePathText" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开缓存目录" Classes="secondary" Click="OpenCacheDir_Click"/>
                    <Button Content="刷新占用信息" Classes="ghost" Click="RefreshStorage_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="StorageSizeText" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Padding="12">
                    <TextBlock Text="普通卸载仅移除程序。Windows 交互式卸载可选择清除当前账户的 SRA 专属目录；不会删除其他文件夹里的原始 PDF 或自定义研究库。macOS 请参见清理说明。外部模型缓存不保证能由 SRA 卸载器清除。" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4"><TextBlock Text="工作区" Classes="h2"/><TextBlock Text="桌面端只通过 localhost API 调用研究核心。" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="10">
                  <Grid ColumnDefinitions="150,*"><TextBlock Text="Local API" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="http://127.0.0.1:8766/api/v1"/></Grid>
                  <Grid ColumnDefinitions="150,*"><TextBlock Text="Desktop" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="{Binding InstalledDesktopVersion}"/></Grid>
                  <Grid ColumnDefinitions="150,*"><TextBlock Text="Core" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="Paper Understanding v2.2"/></Grid>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

    </Grid>

    <Border Grid.Row="2" Classes="statusbar" Padding="13,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" Classes="tertiary" FontSize="9"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="SRA · Local-first" Classes="tertiary" FontSize="9"/>
      </Grid>
    </Border>
  </Grid>
</Window>
