<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SRA.Desktop.ViewModels"
        xmlns:models="using:SRA.Desktop.Models"
        xmlns:controls="using:SRA.Desktop.Controls"
        x:Class="SRA.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Social Science Research IDE"
        Icon="/Assets/sra.ico"
        Width="1560"
        Height="960"
        MinWidth="1080"
        MinHeight="720"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="54"
        CanResize="True"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">
  <!-- The only title bar is this 54 px application chrome. Windows does not draw a second one. -->
  <Grid RowDefinitions="54,*,28">
    <Border Grid.Row="0" Classes="unified-titlebar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Stretch">
        <Border Grid.Column="0" Padding="14,0,20,0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True">
              <Image Source="/Assets/sra-titlebar.png" Stretch="UniformToFill"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Social Science Research IDE" FontSize="13.5"
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
          <Button x:Name="PapersNav" Classes="chrome-nav selected" Click="PapersNav_Click">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <PathIcon Classes="nav-icon" Data="M4 5.5C4 4.67 4.67 4 5.5 4H18.5C19.33 4 20 4.67 20 5.5V18.5C20 19.33 19.33 20 18.5 20H5.5C4.67 20 4 19.33 4 18.5V5.5ZM6 6V18H18V6H6ZM8 9H16V10.5H8V9ZM8 12.5H16V14H8V12.5ZM8 16H13V17.5H8V16Z" />
              <TextBlock Text="论文库" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Button x:Name="TasksNav" Classes="chrome-nav" Click="TasksNav_Click">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <PathIcon Classes="nav-icon" Data="M4 7H20V8.8H4V7ZM4 11.2H15V13H4V11.2ZM4 15.4H12V17.2H4V15.4ZM17.6 11.5L19 12.9L15.4 16.5L13.5 14.6L14.9 13.2L15.4 13.7L17.6 11.5Z" />
              <TextBlock Text="任务" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Button x:Name="HealthNav" Classes="chrome-nav" Click="HealthNav_Click">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <PathIcon Classes="nav-icon" Data="M12 3C7.58 3 4 4.57 4 6.5V17.5C4 19.43 7.58 21 12 21C16.42 21 20 19.43 20 17.5V6.5C20 4.57 16.42 3 12 3ZM12 5C15.53 5 18 6.08 18 6.5C18 6.92 15.53 8 12 8C8.47 8 6 6.92 6 6.5C6 6.08 8.47 5 12 5ZM18 17.5C18 17.92 15.53 19 12 19C8.47 19 6 17.92 6 17.5V14.8C7.54 15.55 9.68 16 12 16C14.32 16 16.46 15.55 18 14.8V17.5ZM18 12.5C18 12.92 15.53 14 12 14C8.47 14 6 12.92 6 12.5V9.8C7.54 10.55 9.68 11 12 11C14.32 11 16.46 10.55 18 9.8V12.5Z" />
              <TextBlock Text="数据" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNav" Classes="chrome-nav" Click="SettingsNav_Click">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <PathIcon Classes="nav-icon" Data="M4 7H14V8.8H4V7ZM17 5.5C18.38 5.5 19.5 6.62 19.5 8C19.5 9.38 18.38 10.5 17 10.5C15.62 10.5 14.5 9.38 14.5 8C14.5 6.62 15.62 5.5 17 5.5ZM10 15.2H20V17H10V15.2ZM7 13.5C8.38 13.5 9.5 14.62 9.5 16C9.5 17.38 8.38 18.5 7 18.5C5.62 18.5 4.5 17.38 4.5 16C4.5 14.62 5.62 13.5 7 13.5Z" />
              <TextBlock Text="设置" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Column="2" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar"/>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Content="＋ 导入 PDF" Classes="primary chrome-import" ToolTip.Tip="导入单个或批量 PDF 文献">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="导入单个 PDF" Click="ImportPdf_Click" />
                <MenuItem Header="批量选择 PDF" Click="BatchImport_Click" />
                <MenuItem Header="导入 PDF 文件夹" Click="FolderImport_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Classes="window-caption" ToolTip.Tip="最小化" Click="MinimizeWindow_Click">
            <!-- Unlike a horizontal Path (zero-height bounds), this remains visible at every DPI. -->
            <Border Width="15" Height="2" CornerRadius="1"
                    Background="{DynamicResource InkBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button Classes="window-caption" ToolTip.Tip="最大化 / 还原" Click="ToggleMaximizeWindow_Click">
            <Path Data="M 2,2 L 12,2 L 12,12 L 2,12 Z" Width="14" Height="14" Stretch="Uniform"
                  StrokeThickness="1.35"
                  StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button Classes="window-caption close" ToolTip.Tip="关闭窗口" Click="CloseWindow_Click">
            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Width="14" Height="14" Stretch="Uniform"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceBody" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="312"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="SidebarPane" Grid.Column="0" Classes="sidebar-pane">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <!-- 左上：文献库标题 + NoteExpress 风格快速筛选药丸（全部 / 已分析 / 待分析） -->
          <StackPanel Grid.Row="0" Margin="16,16,16,8" Spacing="9">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="文献库" Classes="h1" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center">
                <TextBlock Text="论文" Classes="muted" FontSize="10.5" FontWeight="SemiBold"/>
              </Border>
            </Grid>
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Button Classes="scope-chip" Classes.active="{Binding IsFilterAll}" Click="FilterAll_Click">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="全部" Foreground="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="{Binding AllPapersCountLabel}" Foreground="{Binding $parent[Button].Foreground}" Opacity="0.78" />
                </StackPanel>
              </Button>
              <Button Classes="scope-chip" Classes.active="{Binding IsFilterAnalyzed}" Click="FilterAnalyzed_Click">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="已分析" Foreground="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="{Binding AnalyzedPapersCountLabel}" Foreground="{Binding $parent[Button].Foreground}" Opacity="0.78" />
                </StackPanel>
              </Button>
              <Button Classes="scope-chip" Classes.active="{Binding IsFilterPending}" Click="FilterPending_Click">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="待分析" Foreground="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="{Binding PendingPapersCountLabel}" Foreground="{Binding $parent[Button].Foreground}" Opacity="0.78" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>

          <!-- 研究专题目录树（点击联动筛选文献列表，右键直达矩阵/编辑/导出/删除） -->
          <Border Grid.Row="1" Margin="12,2,12,8" Padding="10,9" Classes="tonal-card">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" Margin="4,0,2,0">
                <TextBlock Text="研究专题" FontSize="11.5" FontWeight="SemiBold" Classes="muted" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="＋ 新建" Classes="ghost compact"
                        MinHeight="24" Padding="8,2" FontSize="11"
                        Click="CreateProject_Click" ToolTip.Tip="新建研究专题以聚合多篇论文并生成证据矩阵" />
              </Grid>
              <TextBlock IsVisible="{Binding HasNoProjects}"
                         Text="暂无专题，点击「＋ 新建」聚合跨文献对比。"
                         Classes="tertiary" FontSize="11" Margin="4,2,4,2" TextWrapping="Wrap" />
              <ScrollViewer IsVisible="{Binding HasProjects}" MaxHeight="152" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Projects}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectSummaryView">
                      <Button Classes="topic-node" Tag="{Binding}" Click="SelectProjectNode_Click" Margin="0,0,0,2">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="打开专题证据矩阵" Tag="{Binding}" Click="ContextOpenProjectMatrix_Click" />
                            <MenuItem Header="多文献综合（共识 / 冲突 / 缺口）" Tag="{Binding}" Click="ContextOpenProjectSynthesis_Click" />
                            <MenuItem Header="向此专题添加论文…" Tag="{Binding}" Click="ContextAddPapersToProject_Click" />
                            <MenuItem Header="编辑专题信息" Tag="{Binding}" Click="ContextEditProject_Click" />
                            <MenuItem Header="导出证据矩阵 (Markdown)" Tag="{Binding}" Click="ContextExportProjectMatrix_Click" />
                            <MenuItem Header="导出证据矩阵 (Excel / CSV)" Tag="{Binding}" Click="ContextExportProjectMatrixCsv_Click" />
                            <MenuItem Header="导出专题题录与笔记 (RIS · NoteExpress)" Tag="{Binding}" Click="ContextExportProjectRis_Click" />
                            <Separator />
                            <MenuItem Header="删除此专题" Tag="{Binding}" Click="ContextDeleteProject_Click" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <PathIcon Grid.Column="0" Width="13" Height="13"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Data="M3 6.5C3 5.4 3.9 4.5 5 4.5H9.6L11.4 6.5H19C20.1 6.5 21 7.4 21 8.5V17.5C21 18.6 20.1 19.5 19 19.5H5C3.9 19.5 3 18.6 3 17.5V6.5Z" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                          <Border Grid.Column="2" Classes="badge-count" Padding="6,1">
                            <TextBlock Text="{Binding PaperCount}" Classes="muted" FontSize="10" FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- 搜索栏与当前作用域计数 -->
          <StackPanel Grid.Row="2" Margin="14,0,14,8" Spacing="7">
            <Border Classes="search-shell" Padding="12,0,6,0">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                <PathIcon Grid.Column="0" Width="13" Height="13" Margin="0,0,5,0"
                          Foreground="{DynamicResource InkTertiaryBrush}"
                          Data="M10.5 3.5C6.63 3.5 3.5 6.63 3.5 10.5C3.5 14.37 6.63 17.5 10.5 17.5C12.16 17.5 13.69 16.92 14.89 15.95L19.22 20.28L20.28 19.22L15.95 14.89C16.92 13.69 17.5 12.16 17.5 10.5C17.5 6.63 14.37 3.5 10.5 3.5ZM10.5 5C13.54 5 16 7.46 16 10.5C16 13.54 13.54 16 10.5 16C7.46 16 5 13.54 5 10.5C5 7.46 7.46 5 10.5 5Z" />
                <TextBox x:Name="LibrarySearchBox" Grid.Column="1" Classes="search-input"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         KeyDown="LibrarySearchBox_KeyDown"
                         PlaceholderText="搜索全文/笔记… Enter 展开"/>
                <Button Grid.Column="2" Content="×" Classes="ghost"
                        IsVisible="{Binding HasSearchText}"
                        Command="{Binding ClearSearchCommand}"
                        Width="22" Height="22" MinHeight="22" Padding="0" FontSize="13"
                        ToolTip.Tip="清空搜索 (Esc)" />
                <Button Grid.Column="3" Content="全文" Classes="tonal compact"
                        MinHeight="24" Padding="8,1" FontSize="10.5" Margin="3,0,0,0"
                        Click="OpenFullTextSearch_Click"
                        ToolTip.Tip="打开跨论文 / 专题全文检索面板 (Ctrl+Shift+F)" />
              </Grid>
            </Border>
            <Button IsVisible="{Binding ShowQuickSearchBanner}"
                    Content="{Binding QuickSearchBannerText}"
                    Classes="tonal compact" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Padding="10,4" FontSize="11"
                    Click="OpenFullTextSearch_Click" />
            <Grid ColumnDefinitions="*,Auto" Margin="6,1,5,0">
              <TextBlock Text="{Binding ActiveScopeHeading}" FontWeight="SemiBold" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding LibrarySummary}" Classes="tertiary" FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="6,0,5,0">
              <TextBlock Grid.Column="0" Text="排序" Classes="tertiary" FontSize="10.5" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding LibrarySortOptions}"
                        SelectedItem="{Binding SelectedLibrarySort, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" FontSize="11" MinHeight="26" Padding="8,2" />
            </Grid>
          </StackPanel>

          <!-- 文献列表（自带原生右键上下文菜单，告别杂物三个点） -->
          <Grid Grid.Row="3" Margin="10,0,10,14">
            <ListBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}"
                     Classes="library-list" SelectionMode="Single">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:PaperSummary">
                  <Border Classes="paper-list-card" Padding="12,11">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="打开 PDF 原文" Tag="{Binding}" Click="ContextOpenPaperPdf_Click" />
                        <MenuItem Header="开始 / 重新分析" Tag="{Binding}" Click="ContextAnalyzePaper_Click" />
                        <MenuItem Header="局部复核与 OCR" Tag="{Binding}" Click="ContextRegionReviewPaper_Click" />
                        <Separator />
                        <MenuItem Header="归入研究专题…" Tag="{Binding}" Click="ContextAssignPaperProjects_Click" />
                        <MenuItem Header="编辑题录元数据" Tag="{Binding}" Click="ContextEditPaperMetadata_Click" />
                        <MenuItem Header="提取参考文献" Tag="{Binding}" Click="ContextExtractPaperReferences_Click" />
                        <MenuItem Header="导出">
                          <MenuItem Header="导出题录与笔记 (RIS · NoteExpress)" Tag="{Binding}" Click="ContextExportRis_Click" />
                          <MenuItem Header="导出精读报告 (Markdown)" Tag="{Binding}" Click="ContextExportReading_Click" />
                          <MenuItem Header="导出 Paper Card (JSON)" Tag="{Binding}" Click="ContextExportCard_Click" />
                          <MenuItem Header="导出解析文本 (TXT)" Tag="{Binding}" Click="ContextExportText_Click" />
                          <MenuItem Header="导出参考文献 (BibTeX)" Tag="{Binding}" Click="ContextExportBibtex_Click" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="重建 PDF 解析" Tag="{Binding}" Click="ContextReparsePaper_Click" />
                        <MenuItem Header="永久删除论文" Tag="{Binding}" Click="ContextDeletePaper_Click" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                      <Border Grid.Column="0" Width="3" Classes="paper-selection-marker" CornerRadius="99"/>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="2" LineHeight="19.5"/>
                        <TextBlock Text="{Binding AuthorLine}" Classes="muted" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,1,0,0">
                          <TextBlock Text="{Binding StatusLine}" Classes="tertiary" FontSize="10.5" VerticalAlignment="Center"/>
                          <Border Grid.Column="1" IsVisible="{Binding HasCard}" VerticalAlignment="Center"
                                  Background="{DynamicResource EmeraldSoftBrush}"
                                  BorderBrush="{DynamicResource EmeraldLineBrush}"
                                  BorderThickness="1" CornerRadius="999" Padding="7,2">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <Ellipse Width="5" Height="5" Fill="{DynamicResource EmeraldInkBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="已分析" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                        </Grid>
                        <Border IsVisible="{Binding HasHumanBadge}" HorizontalAlignment="Left"
                                Background="{DynamicResource BlueSoftBrush}"
                                BorderBrush="{DynamicResource BlueLineBrush}"
                                BorderThickness="1" CornerRadius="999" Padding="7,1">
                          <TextBlock Text="{Binding HumanBadgeText}" Foreground="{DynamicResource BlueInkBrush}" FontSize="10" FontWeight="Medium" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding IsLibraryEmpty}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" MaxWidth="240" Spacing="10">
              <TextBlock Text="当前视图下暂无文献" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
              <TextBlock Text="直接拖入 PDF、点击导入，或切换左侧筛选/研究专题。" Classes="muted" FontSize="12"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
              <Button Content="导入 PDF" Classes="primary compact" Click="ImportPdf_Click" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <!-- Papers -->
      <DockPanel x:Name="PapersPage" Grid.Column="1" LastChildFill="True">
<Border DockPanel.Dock="Right" Width="288" Classes="inspector-pane" IsVisible="{Binding ShowInspector}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,20,18,24" Spacing="16">
            <StackPanel Spacing="3">
              <TextBlock Text="研究画像" Classes="h2" />
              <TextBlock Text="依据已提取的论文结构与审计记录" Classes="tertiary" FontSize="11.5" />
            </StackPanel>

            <!-- 就地所属研究专题卡片（一眼看清归属，点芯片直跳专题，点＋直接归档） -->
            <Border Classes="inspector-section" Padding="14" IsVisible="{Binding HasSelection}">
              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="所属研究专题" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="＋ 归入专题" Classes="tonal compact"
                          MinHeight="25" Padding="9,2" FontSize="11"
                          Click="AssignSelectedPaperProjects_Click" />
                </Grid>
                <TextBlock IsVisible="{Binding HasNoSelectedPaperProjects}"
                           Text="尚未归入任何研究专题。" Classes="tertiary" FontSize="11.5" />
                <ItemsControl ItemsSource="{Binding SelectedPaperProjects}" IsVisible="{Binding HasSelectedPaperProjects}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectSummaryView">
                      <Button Classes="topic-chip" Content="{Binding Name}" Tag="{Binding}"
                              Click="OpenProjectMatrixDirect_Click"
                              ToolTip.Tip="点击进入该专题的跨文献证据矩阵" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- 个人阅读笔记与单条主张人工审定摘要卡 -->
            <Border Classes="inspector-section" Padding="14" IsVisible="{Binding HasSelection}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="我的笔记与审定" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="我的笔记 →" Classes="tonal compact"
                          MinHeight="25" Padding="9,2" FontSize="11"
                          Click="OpenNotesTab_Click" />
                </Grid>
                <TextBlock Text="{Binding HumanProgressSummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ClaimReviewBreakdown}" Classes="muted" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="inspector-section" Padding="14">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3"><TextBlock Text="STUDY TYPE" Classes="eyebrow"/><TextBlock Text="{Binding SelectedStudyType}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13.5"/></StackPanel>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" />
                <StackPanel Spacing="3"><TextBlock Text="METHOD" Classes="eyebrow"/><TextBlock Text="{Binding SelectedStudyMethod}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" MaxLines="4" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Spacing="3"><TextBlock Text="IDENTIFICATION" Classes="eyebrow"/><TextBlock Text="{Binding SelectedIdentification}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" MaxLines="4" TextTrimming="CharacterEllipsis"/></StackPanel>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
              <Border Grid.Column="0" Classes="metric-cell" Padding="10,9"><StackPanel Spacing="2" HorizontalAlignment="Center"><TextBlock Text="FACTS" Classes="eyebrow" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedFactsCount}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
              <Border Grid.Column="1" Classes="metric-cell" Padding="10,9"><StackPanel Spacing="2" HorizontalAlignment="Center"><TextBlock Text="EVIDENCE" Classes="eyebrow" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedEvidenceCount}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
              <Border Grid.Column="2" Classes="metric-cell" Padding="10,9"><StackPanel Spacing="2" HorizontalAlignment="Center"><TextBlock Text="REVIEW" Classes="eyebrow" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedReviewsCount}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Text="审读计划" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="{Binding ReviewPlanText}" Classes="muted" TextWrapping="Wrap" FontSize="12" LineHeight="19" MaxLines="5" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" />

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="运行状态" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{Binding JobStage}" Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding JobProgress}" IsIndeterminate="{Binding JobIndeterminate}" Height="5" />
              <TextBlock Text="{Binding SelectedParseStatus}" Classes="tertiary" TextWrapping="Wrap" FontSize="11.5" />
              <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" FontSize="11.5" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" />

            <StackPanel Spacing="8">
              <TextBlock Text="来源标识图例" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="作者原话、AI 批判审读与个人笔记在卡片左侧色条与标签中严格区分。" Classes="muted" TextWrapping="Wrap" FontSize="11.5" LineHeight="18" />
              <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Border Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,3">
                  <TextBlock Text="AUTHOR" Foreground="{DynamicResource BlueInkBrush}" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.4"/>
                </Border>
                <Border Background="{DynamicResource PurpleSoftBrush}" BorderBrush="{DynamicResource PurpleLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,3">
                  <TextBlock Text="AI REVIEW" Foreground="{DynamicResource PurpleInkBrush}" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.4"/>
                </Border>
                <Border Background="{DynamicResource EmeraldSoftBrush}" BorderBrush="{DynamicResource EmeraldLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,3">
                  <TextBlock Text="HUMAN REVIEWED" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.4"/>
                </Border>
                <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,3">
                  <TextBlock Text="MY NOTE" Classes="muted" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.4"/>
                </Border>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
<Grid RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
        <!-- 选中研究专题时的上下文控制条：单篇精读 | 专题证据矩阵无缝切换 -->
        <Border Grid.Row="0" IsVisible="{Binding IsProjectScopeActive}"
                Background="{DynamicResource SurfaceContainerLowBrush}"
                BorderBrush="{DynamicResource OutlineSubtleBrush}"
                BorderThickness="0,0,0,1" Padding="24,12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
              <WrapPanel ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
                <TextBlock Text="TOPIC" Classes="eyebrow" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveProjectName}" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Classes="badge">
                  <TextBlock Text="{Binding MatrixStatsText}" Classes="muted" FontSize="10.5" FontWeight="Medium" />
                </Border>
              </WrapPanel>
              <TextBlock IsVisible="{Binding HasActiveProjectQuestion}"
                         Text="{Binding ActiveProjectQuestion}" Classes="muted" FontSize="12"
                         TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="999" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="单篇精读" Classes="mode-pill" Classes.active="{Binding ShowSinglePaperView}" Click="SwitchToSingleView_Click" />
                  <Button Content="专题证据矩阵" Classes="mode-pill" Classes.active="{Binding ShowProjectMatrixView}" Click="SwitchToMatrixView_Click" />
                  <Button Content="多文献综合" Classes="mode-pill" Classes.active="{Binding ShowProjectSynthesisView}" Click="SwitchToSynthesisView_Click" />
                  <Button Content="全文检索" Classes="mode-pill" Classes.active="{Binding ShowSearchPanelView}" Click="OpenFullTextSearch_Click" />
                </StackPanel>
              </Border>
              <Button Content="{Binding AnalyzeActiveProjectPendingButtonText}" Classes="primary compact"
                      IsVisible="{Binding HasPendingPapersInActiveProject}" IsEnabled="{Binding !IsBusy}"
                      Click="AnalyzeActiveProjectPending_Click"
                      ToolTip.Tip="仅分析当前研究专题内尚未生成 Paper Card 的论文（不影响其他专题）" />
              <Button Content="＋ 添加文献" Classes="tonal compact" Click="AddPapersToActiveProject_Click" />
              <Button Content="导出矩阵 ▾" Classes="secondary compact" IsEnabled="{Binding HasAnyMatrixRowsInProject}" ToolTip.Tip="导出当前专题证据矩阵为 Excel CSV、Markdown 或 NoteExpress RIS">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="导出为 Excel / CSV（UTF-8 BOM）" Click="ExportActiveMatrixCsv_Click" />
                    <MenuItem Header="导出为 Markdown（含专题笔记与审定）" Click="ExportActiveMatrixMarkdown_Click" />
                    <Separator />
                    <MenuItem Header="导出专题题录与笔记 (RIS · NoteExpress)" Click="ExportActiveProjectRis_Click" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Content="编辑专题" Classes="ghost compact" Click="EditActiveProject_Click" />
              <Button Content="退出专题" Classes="ghost compact" Click="ExitProjectScope_Click" ToolTip.Tip="返回全部论文视图" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 主区容器：在「单篇精读工作台」与「专题 Evidence Matrix」之间无缝切换 -->
        <Grid Grid.Row="1">
          <!-- A. 单篇文献精读工作台 -->
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowSinglePaperView}">
            <Border Grid.Row="0" Classes="workspace-header" Padding="26,18,26,18">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Grid.Column="0" Spacing="6">
                  <WrapPanel ItemSpacing="8" LineSpacing="5" VerticalAlignment="Center">
                    <TextBlock Text="PAPER" Classes="eyebrow" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="•" Classes="tertiary" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedAnalysisState}" Classes="muted" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding HasManualMetadata}" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                      <TextBlock Text="手动修订" Foreground="{DynamicResource AmberInkBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Text="{Binding SelectedTitle}" Classes="document-title" TextWrapping="Wrap" MaxLines="2" />
                  <TextBlock Text="{Binding SelectedSubtitle}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 清爽直给的主操作栏（彻底取消杂物 ••• 菜单；维护/删除归位右键菜单与概览维护卡） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="{Binding AnalyzeButtonText}" Classes="primary" IsEnabled="{Binding CanRunPaperActions}" Click="Analyze_Click" />
                  <Button Content="打开 PDF" Classes="tonal" IsEnabled="{Binding HasSelection}" Click="OpenPdf_Click" />
                  <Button Content="局部复核" Classes="tonal" IsEnabled="{Binding HasSelection}" Click="RegionReview_Click" ToolTip.Tip="原 PDF 与提取结果对照、区域 OCR、人工确认" />
                  <Button Content="导出 ▾" Classes="secondary" IsEnabled="{Binding HasSelection}" ToolTip.Tip="导出当前论文题录 (NoteExpress RIS)、精读报告、JSON、纯文本或 BibTeX">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="导出题录与笔记 (RIS · NoteExpress)" Click="ExportRis_Click" />
                        <MenuItem Header="导出精读报告 (Markdown)" Click="ExportReading_Click" />
                        <MenuItem Header="导出 Paper Card (JSON)" Click="ExportCard_Click" />
                        <MenuItem Header="导出解析文本 (TXT)" Click="ExportText_Click" />
                        <MenuItem Header="导出参考文献 (BibTeX)" Click="ExportBibtex_Click" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                  <Button Content="专注阅读" Classes="ghost focus-toggle" ToolTip.Tip="显示或收起右侧研究画像 (Ctrl+/)" Click="ToggleInspector_Click" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" Classes="workspace-surface" Margin="12,12,12,14">
              <TabControl x:Name="PaperTabs" Classes="paper-tabs">
            <!-- Product focus: deep reading first -->
            <TabItem Header="精读">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,54" Spacing="30" MaxWidth="900" HorizontalAlignment="Center">
                  <StackPanel Spacing="10">
                    <TextBlock Text="论文定位" Classes="section-title" />
                    <Border Classes="reading-lead" Padding="24,20">
                      <TextBlock Text="{Binding AbstractText}" TextWrapping="Wrap" FontSize="14.5" LineHeight="26" />
                    </Border>
                  </StackPanel>

                  <Border Classes="soft-card" Padding="20,16" IsVisible="{Binding IsUnanalyzedSelected}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="准备就绪 · 尚未生成 Paper Card" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="PDF 原文块已完成解析。点击右侧「开始分析」以提取可溯源基础事实、研究设计画像与方法学审读。" Classes="muted" FontSize="12.5" TextWrapping="Wrap" LineHeight="20" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="开始分析" Classes="primary" IsEnabled="{Binding CanRunPaperActions}" Click="Analyze_Click" VerticalAlignment="Center" />
                    </Grid>
                  </Border>

                  <StackPanel Spacing="10" IsVisible="{Binding HasCard}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="研究设计画像" Classes="section-title" />
                      <TextBlock Grid.Column="1" Text="STUDY PROFILE" Classes="eyebrow" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                      <Border Grid.Column="0" Classes="design-cell" Padding="14,13">
                        <StackPanel Spacing="5"><TextBlock Text="研究类型" Classes="eyebrow"/><TextBlock Text="{Binding SelectedStudyType}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"/></StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="design-cell" Padding="14,13">
                        <StackPanel Spacing="5"><TextBlock Text="方法" Classes="eyebrow"/><TextBlock Text="{Binding SelectedStudyMethod}" TextWrapping="Wrap" FontSize="13" LineHeight="20"/></StackPanel>
                      </Border>
                      <Border Grid.Column="2" Classes="design-cell" Padding="14,13">
                        <StackPanel Spacing="5"><TextBlock Text="识别 / 推断策略" Classes="eyebrow"/><TextBlock Text="{Binding SelectedIdentification}" TextWrapping="Wrap" FontSize="13" LineHeight="20"/></StackPanel>
                      </Border>
                    </Grid>
                    <Border Classes="reading-lead" Padding="15,11" IsVisible="{Binding HasStudyRationale}">
                      <TextBlock Text="{Binding StudyRationale}" Classes="muted" TextWrapping="Wrap" FontSize="12.5" LineHeight="21" />
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="10" IsVisible="{Binding HasResearchQuestions}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="研究问题" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding ResearchQuestionsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding ResearchQuestions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasTheoryConcepts}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="理论与概念" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding TheoryConceptsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding TheoryConcepts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasResearchDesignClaims}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="研究设计" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding ResearchDesignCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding ResearchDesignClaims}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasMajorFindings}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="核心发现" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding MajorFindingsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding MajorFindings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasAuthorExplanations}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="作者解释 / 机制" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding AuthorExplanationsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding AuthorExplanations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasAnalysisClaims}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="方法学审读" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding AnalysisClaimsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding AnalysisClaims}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasAuthorLimitations}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="作者自述局限" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding AuthorLimitationsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding AuthorLimitations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasAiLimitations}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="AI 发现局限" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding AiLimitationsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding AiLimitations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasReadingRecommendations}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="阅读建议" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding ReadingRecommendationsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding ReadingRecommendations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="概览">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,28,30,45" Spacing="24">
                  <!-- Keep extracted metadata audit warnings visible without
                       overwhelming the actual book information / abstract. -->
                  <Border Background="{DynamicResource AmberSoftBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding HasWarnings}">
                    <Expander IsExpanded="False">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="待核验" Foreground="{DynamicResource AmberInkBrush}" FontWeight="SemiBold" FontSize="12"/>
                          <TextBlock Text="{Binding WarningsSummary}" Foreground="{DynamicResource AmberInkBrush}" FontSize="11"/>
                        </StackPanel>
                      </Expander.Header>
                      <TextBlock Text="{Binding WarningsText}" Foreground="{DynamicResource AmberInkBrush}"
                                 TextWrapping="Wrap" Margin="4,8,4,3" FontSize="11" />
                    </Expander>
                  </Border>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="card" Padding="16">
                      <StackPanel Spacing="11">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="书目信息" Classes="section-title" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="编辑题录" Classes="tonal compact"
                                  IsEnabled="{Binding HasSelection}" Click="EditMetadata_Click" />
                        </Grid>
                        <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                          <TextBlock Grid.Row="0" Text="题名" Classes="eyebrow"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MetadataTitle}" TextWrapping="Wrap"/>
                          <TextBlock Grid.Row="1" Text="作者" Classes="eyebrow"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MetadataAuthors}" TextWrapping="Wrap"/>
                          <TextBlock Grid.Row="2" Text="期刊" Classes="eyebrow"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MetadataJournal}" TextWrapping="Wrap"/>
                          <TextBlock Grid.Row="3" Text="年份" Classes="eyebrow"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MetadataYear}"/>
                          <TextBlock Grid.Row="4" Text="卷 / 期 / 页" Classes="eyebrow"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding MetadataVolumeIssue}"/><TextBlock Text="{Binding MetadataPages}" Classes="muted"/></StackPanel>
                          <TextBlock Grid.Row="5" Text="DOI" Classes="eyebrow"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MetadataDoi}" TextWrapping="Wrap"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Padding="16">
                      <StackPanel Spacing="10">
                        <TextBlock Text="摘要" Classes="section-title" />
                        <TextBlock Text="{Binding AbstractText}" TextWrapping="Wrap" LineHeight="23" FontSize="13" Classes="muted" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <StackPanel Spacing="8">
                    <TextBlock Text="关键词" Classes="section-title" />
                    <ItemsControl ItemsSource="{Binding Keywords}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="badge" Margin="0,0,6,6"><TextBlock Text="{Binding}" Classes="muted" FontSize="10"/></Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- 低频文献维护卡片（与论文列表右键菜单互补，物理隔离不可逆危险操作） -->
                  <Border Classes="soft-card" Padding="16,14" IsVisible="{Binding HasSelection}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="文献维护" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock Text="重建解析会重新运行 Docling 并保留手动题录修订；永久删除不可恢复。"
                                   Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="重建 PDF 解析" Classes="secondary compact" Click="Reparse_Click" />
                        <Button Content="删除论文" Classes="danger compact" Click="DeletePaper_Click" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="我的笔记">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26,32,52" Spacing="24" MaxWidth="900" HorizontalAlignment="Center">
                  <!-- 顶部：就地快速记录个人笔记（MY NOTE） -->
                  <Border Classes="card" Padding="20,18">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                          <WrapPanel ItemSpacing="8" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                              <TextBlock Text="MY NOTE" Classes="muted" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.4" />
                            </Border>
                            <TextBlock Text="新增个人阅读笔记" Classes="section-title" VerticalAlignment="Center" />
                          </WrapPanel>
                          <TextBlock Text="笔记独立存储于本地 SQLite，重新分析或重建解析绝不覆盖，并实时纳入全文检索（Ctrl+Enter 快速保存）。"
                                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>

                      <Grid ColumnDefinitions="*,140" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding DraftNoteTitle, Mode=TwoWay}"
                                 PlaceholderText="笔记标题（可选，如「与田野经验的张力」）" />
                        <TextBox Grid.Column="1" Text="{Binding DraftNotePage, Mode=TwoWay}"
                                 PlaceholderText="关联 PDF 页码" />
                      </Grid>

                      <TextBox Text="{Binding DraftNoteBody, Mode=TwoWay}"
                               PlaceholderText="记录你的阅读反思、方法质疑、理论联系或后续引用思路…"
                               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                               KeyDown="DraftNoteBody_KeyDown" />

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="提示：填写关联页码后，笔记卡片上可直接一键跳回 PDF 对应页。"
                                   Classes="tertiary" FontSize="11.5" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="＋ 保存笔记" Classes="primary"
                                IsEnabled="{Binding HasSelection}" Click="SaveDraftNote_Click" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- 中部：已保存个人笔记列表 -->
                  <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="个人笔记列表" Classes="section-title" />
                      <Border Classes="badge-count">
                        <TextBlock Text="{Binding UserNotesCount}" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>

                    <Border Classes="soft-card" Padding="24,20" IsVisible="{Binding HasNoUserNotes}">
                      <TextBlock Text="还没有为这篇论文记录个人笔记。在上方输入框记下你的思考，即可自动建立与本文的长期关联。"
                                 Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding UserNotes}" IsVisible="{Binding HasUserNotes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:UserNoteItem">
                          <Border Classes="note-card" Margin="0,0,0,12" ClipToBounds="True">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="编辑笔记" Tag="{Binding}" Click="EditNote_Click" />
                                <MenuItem Header="跳转到关联 PDF 页" IsVisible="{Binding HasPageNumber}" Tag="{Binding}" Click="NoteJumpPage_Click" />
                                <MenuItem Header="复制笔记正文" Tag="{Binding}" Click="CopyNote_Click" />
                                <Separator />
                                <MenuItem Header="删除笔记" Tag="{Binding}" Click="DeleteNote_Click" />
                              </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="4,*">
                              <Border Grid.Column="0" Background="{DynamicResource InkTertiaryBrush}" />
                              <StackPanel Grid.Column="1" Margin="18,15,18,16" Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                  <WrapPanel Grid.Column="0" ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                      <TextBlock Text="MY NOTE" Classes="muted" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TimeLabel}" Classes="tertiary" FontSize="11" VerticalAlignment="Center" />
                                    <Button IsVisible="{Binding HasPageNumber}" Content="{Binding PageBadgeLabel}"
                                            Classes="tonal compact" MinHeight="22" Padding="8,1" FontSize="10.5"
                                            Tag="{Binding}" Click="NoteJumpPage_Click"
                                            ToolTip.Tip="在局部复核窗口中定位到该 PDF 页面" />
                                  </WrapPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="编辑" Classes="secondary compact" MinHeight="26" Padding="10,2" FontSize="11.5"
                                            Tag="{Binding}" Click="EditNote_Click" />
                                    <Button Content="删除" Classes="ghost compact" MinHeight="26" Padding="9,2" FontSize="11.5"
                                            Tag="{Binding}" Click="DeleteNote_Click" />
                                  </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Note}" FontSize="13.5" LineHeight="23" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- 底部：本篇论文单条主张人工审定记录总览 -->
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="单条主张人工审定记录" Classes="section-title" />
                        <Border Classes="badge-count">
                          <TextBlock Text="{Binding ReviewedClaimsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ClaimReviewBreakdown}" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                    </Grid>

                    <Border Classes="soft-card" Padding="18,14" IsVisible="{Binding !HasClaimReviews}">
                      <TextBlock Text="在「精读」「事实证据」或「AI 审读」标签页中，点击任意主张卡片底部的「✓ 确认 / ✎ 修正 / ✕ 存疑 / ? 待定」，所有审定结果都将汇总于此并同步至专题证据矩阵。"
                                 Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding ClaimReviews}" IsVisible="{Binding HasClaimReviews}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ClaimReviewItem">
                          <Border Classes="card" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <WrapPanel Grid.Column="0" ItemSpacing="7" LineSpacing="4" VerticalAlignment="Center">
                                  <Border IsVisible="{Binding IsConfirmed}" Background="{DynamicResource EmeraldSoftBrush}" BorderBrush="{DynamicResource EmeraldLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                  </Border>
                                  <Border IsVisible="{Binding IsCorrected}" Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource BlueInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                  </Border>
                                  <Border IsVisible="{Binding IsRejected}" Background="{DynamicResource RedSoftBrush}" BorderBrush="{DynamicResource RedLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource RedInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                  </Border>
                                  <Border IsVisible="{Binding IsUnresolved}" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource AmberInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                  </Border>
                                  <Border Classes="badge" Padding="7,2">
                                    <TextBlock Text="{Binding FieldLabel}" Classes="muted" FontSize="10.5" FontWeight="Medium" />
                                  </Border>
                                  <Border IsVisible="{Binding IsOrphan}" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                    <TextBlock Text="历史重跑保留" Foreground="{DynamicResource AmberInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                  </Border>
                                  <TextBlock Text="{Binding TimeLabel}" Classes="tertiary" FontSize="11" VerticalAlignment="Center" />
                                </WrapPanel>
                                <Button Grid.Column="1" Content="清除" Classes="ghost compact" MinHeight="24" Padding="8,1" FontSize="11"
                                        Tag="{Binding}" Click="DeleteReviewRecord_Click" />
                              </Grid>
                              <TextBlock IsVisible="{Binding HasOriginalStatement}" Text="{Binding OriginalStatement, StringFormat='原陈述：{0}'}"
                                         Classes="muted" FontSize="12.5" LineHeight="20" TextWrapping="Wrap" />
                              <Border IsVisible="{Binding HasCorrectedStatement}" Classes="human-correction-block" Padding="12,9">
                                <TextBlock Text="{Binding CorrectedStatement, StringFormat='人工修正：{0}'}"
                                           FontSize="13" FontWeight="Medium" LineHeight="21" TextWrapping="Wrap" />
                              </Border>
                              <TextBlock IsVisible="{Binding HasNote}" Text="{Binding Note, StringFormat='审定备注：{0}'}"
                                         Classes="muted" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="事实证据">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,48" Spacing="26" MaxWidth="920" HorizontalAlignment="Center">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="书目信息证据" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding MetadataClaimsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding MetadataClaims}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="基础事实" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding BasicFactsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding BasicFacts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="AI 审读">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,48" Spacing="26" MaxWidth="920" HorizontalAlignment="Center">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="方法与贡献审读" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding AnalysisClaimsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding AnalysisClaims}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="潜在局限" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding AiLimitationsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding AiLimitations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="阅读建议" Classes="section-title"/><Border Classes="badge-count"><TextBlock Text="{Binding ReadingRecommendationsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel>
                    <ItemsControl ItemsSource="{Binding ReadingRecommendations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClaimItem"><controls:ClaimCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="参考文献">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" Spacing="13">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3"><TextBlock Text="参考文献" Classes="section-title"/><TextBlock Text="{Binding ReferenceStatusText}" Classes="muted" FontSize="10"/></StackPanel>
                    <Button Grid.Column="1" Content="导出" Classes="secondary compact" IsEnabled="{Binding HasSelection}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="导出 JSON" Click="ExportReferencesJson_Click" />
                          <MenuItem Header="导出 BibTeX" Click="ExportBibtex_Click" />
                          <MenuItem Header="重新提取参考文献" Click="ExtractReferences_Click" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding References}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:ReferenceItem">
                        <Border Classes="card" Padding="13" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Top">
                              <TextBlock Text="{Binding Ordinal}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Classes="muted" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                              <TextBlock Text="{Binding RawText}" TextWrapping="Wrap" />
                              <WrapPanel ItemSpacing="6"><TextBlock Text="{Binding MetaLine}" Classes="tertiary" FontSize="9"/><TextBlock Text="{Binding ParseStatus}" Classes="tertiary" FontSize="9"/></WrapPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="表格">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,22,24,36" Spacing="12">
                  <StackPanel Spacing="5">
                    <TextBlock Text="结构化表格预览" Classes="section-title"/>
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="按 Docling 单元格坐标呈现合并表头；旧 Card 仅提供二维行列预览。复杂跨页表格和数值请打开 PDF 核对。" />
                  </StackPanel>

                  <Border Classes="reading-lead" Padding="15,12" IsVisible="{Binding HasNoTables}">
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="当前 Paper Card 没有可预览的表格。如果原 PDF 含表格，请先检查 Docling 解析和文献页码。" />
                  </Border>

                  <ItemsControl ItemsSource="{Binding Tables}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:TableItem">
                        <Border Classes="card" Padding="15" Margin="0,0,0,12">
                          <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <TextBlock Text="PDF 第" Classes="eyebrow"/>
                                  <TextBlock Text="{Binding Page}" Classes="eyebrow"/>
                                  <TextBlock Text="页" Classes="eyebrow"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Dimensions}" Classes="muted" FontSize="11" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="TABLE PREVIEW" Classes="eyebrow"
                                         VerticalAlignment="Center" />
                            </Grid>

                            <!-- Span-aware native Avalonia grid. No markdown flattening:
                                 row_span / col_span drive actual Grid attached properties. -->
                            <controls:StructuredTableView IsVisible="{Binding HasStructuredRows}"
                                                          Table="{Binding}" />

                            <!-- Some PDFs yield table text but no reliable cell grid.
                                 Make it visible rather than showing an empty card. -->
                            <TextBox IsVisible="{Binding HasRawOnly}"
                                     Text="{Binding DisplayText}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Background="{DynamicResource SurfaceSoftBrush}" Foreground="{DynamicResource InkBrush}"
                                     BorderThickness="0" Padding="10"
                                     FontSize="11" MaxHeight="300"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

                            <Expander IsVisible="{Binding HasStructuredRows}" IsExpanded="False"
                                      Header="查看原始提取文本（可复制 / 核对）">
                              <TextBox Text="{Binding DisplayText}" IsReadOnly="True"
                                       AcceptsReturn="True" TextWrapping="NoWrap"
                                       Background="{DynamicResource SurfaceSoftBrush}" Foreground="{DynamicResource InkBrush}"
                                       BorderThickness="0" Padding="10" FontFamily="Consolas"
                                       FontSize="10" MaxHeight="260"
                                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Expander>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="公式与图片">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,26,28,40" Spacing="18">
                  <StackPanel Spacing="6">
                    <TextBlock Text="数学公式与图像来源" Classes="section-title"/>
                    <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="11"
                               Text="这里展示 Docling 提取到的公式文字和图片来源定位，不把图片描述当作已验证事实。点击顶部「打开 PDF」核对原文页面。" />
                    <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="11"
                               Text="在「设置 → 公式与图片增强」中开启 Docling 本地公式识别，重新解析并重新分析后生效。图片视觉分析使用独立配置的 Vision 模型，只有点击单张图片的分析按钮才会联网并可能计费。" />
                  </StackPanel>
                  <Border Classes="reading-lead" Padding="14,12" IsVisible="{Binding HasNoVisuals}">
                    <TextBlock TextWrapping="Wrap" Classes="muted"
                               Text="当前 Paper Card 没有公式或图片定位信息。旧版 Card 需要重新解析并重新分析才能填充。" />
                  </Border>
                  <StackPanel Spacing="9">
                    <TextBlock Text="公式" Classes="section-title" />
                    <ItemsControl ItemsSource="{Binding Formulas}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:VisualSourceItem">
                          <Border Classes="card" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="7">
                              <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="PDF p." Classes="eyebrow"/>
                                <TextBlock Text="{Binding Page}" Classes="eyebrow"/>
                                <TextBlock Text="{Binding Label}" Classes="tertiary" FontSize="10"/>
                              </StackPanel>
                              <TextBox Text="{Binding Text}" IsReadOnly="True"
                                       AcceptsReturn="True" TextWrapping="Wrap"
                                       Background="{DynamicResource SurfaceSoftBrush}" Foreground="{DynamicResource InkBrush}"
                                        SelectionBrush="{DynamicResource AccentSoftBrush}"
                                        SelectionForegroundBrush="{DynamicResource InkBrush}" BorderThickness="0"
                                       Padding="10" FontFamily="Consolas" FontSize="12" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="9">
                    <TextBlock Text="图片 / 统计图位置" Classes="section-title" />
                    <ItemsControl ItemsSource="{Binding Figures}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:VisualSourceItem">
                          <Border Classes="card" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                              <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="PDF p." Classes="eyebrow"/>
                                <TextBlock Text="{Binding Page}" Classes="eyebrow"/>
                                <TextBlock Text="{Binding Label}" Classes="tertiary" FontSize="10"/>
                              </StackPanel>
                              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="区域坐标（PDF points）" Classes="eyebrow"/>
                                <TextBlock Text="{Binding Location}" Classes="muted" FontSize="10"/>
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="本地预览裁剪图（不收费）" Classes="tonal"
                                        Tag="{Binding}" Click="PreviewFigure_Click"/>
                                <Button Content="确认后分析该图片（Vision API，可能计费）"
                                        Tag="{Binding}" Click="AnalyzeFigure_Click" Classes="secondary"/>
                              </StackPanel>
                              <Image Source="{Binding PreviewImage}" IsVisible="{Binding HasPreview}"
                                     Stretch="Uniform" MaxWidth="680" MaxHeight="420"
                                     HorizontalAlignment="Left"/>
                              <TextBlock Text="{Binding AiResult}" TextWrapping="Wrap"
                                         FontSize="11" Foreground="{DynamicResource InkBrush}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="原始 Card">
              <Grid Margin="18" RowDefinitions="Auto,*" RowSpacing="10">
                <Border Grid.Row="0" Classes="tonal-card" Padding="14,10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="{Binding RawCardSummaryText}" Classes="muted" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="{Binding RawCardToggleButtonText}" Classes="ghost compact"
                              IsVisible="{Binding IsRawCardTruncated}" Click="ToggleFullRawCard_Click" />
                      <Button Content="复制完整 JSON" Classes="tonal compact"
                              IsEnabled="{Binding HasCard}" Click="CopyRawCardJson_Click" />
                      <Button Content="导出 JSON" Classes="secondary compact"
                              IsEnabled="{Binding HasCard}" Click="ExportCard_Click" />
                    </StackPanel>
                  </Grid>
                </Border>
                <TextBox Grid.Row="1" x:Name="RawCardTextBox" Classes="readonly-code"
                         Text="{Binding RawCardJson}" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         Padding="14" Background="{DynamicResource SurfaceSoftBrush}" Foreground="{DynamicResource InkBrush}"
                         SelectionBrush="{DynamicResource AccentSoftBrush}" SelectionForegroundBrush="{DynamicResource InkBrush}"
                         BorderThickness="0" CornerRadius="10" FontFamily="Consolas" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              </Grid>
            </TabItem>

            <TabItem Header="日志">
              <Grid Margin="22" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                  <StackPanel Spacing="2"><TextBlock Text="{Binding JobStage}" Classes="section-title"/><TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="10"/></StackPanel>
                  <ProgressBar Grid.Column="1" Width="180" Height="5" Minimum="0" Maximum="100" Value="{Binding JobProgress}" IsIndeterminate="{Binding JobIndeterminate}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="取消任务" Classes="secondary compact" Click="CancelJob_Click" IsVisible="{Binding CanCancelJob}" VerticalAlignment="Center" />
                </Grid>
                <TextBox Grid.Row="1" Classes="readonly-code"
                         Text="{Binding JobLog}" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap"
                         Padding="14" Background="{DynamicResource SurfaceSoftBrush}" Foreground="{DynamicResource InkBrush}"
                          SelectionBrush="{DynamicResource AccentSoftBrush}" SelectionForegroundBrush="{DynamicResource InkBrush}" BorderThickness="0" CornerRadius="8" FontFamily="Consolas" FontSize="10" />
              </Grid>
            </TabItem>
              </TabControl>
            </Border>
          </Grid>

          <!-- B. 跨文献 Evidence Matrix 对比工作区（纯本地确定性聚合，零额外 LLM 调用） -->
          <Border Classes="workspace-surface" Margin="12,12,12,14" IsVisible="{Binding ShowProjectMatrixView}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="26,22,26,44" Spacing="18">
                <Border Classes="tonal-card" Padding="18,14">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="4">
                      <TextBlock Text="EVIDENCE MATRIX · 跨文献证据对比矩阵" Classes="eyebrow" Foreground="{DynamicResource AccentBrush}" />
                      <TextBlock Text="基于已保存 Paper Card 做确定性结构对齐，严格区分 AUTHOR 陈述、AI REVIEW 审读与 HUMAN REVIEWED 人工修正，不发起任何外部模型调用。点击引文页码可直接跳回该论文 PDF 原文高亮。"
                                 Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="删除专题" Classes="danger compact" VerticalAlignment="Center"
                            Click="DeleteActiveProject_Click" />
                  </Grid>
                </Border>

                <!-- 专题级跨文献研究笔记（MY NOTE，随专题 Markdown 矩阵一并导出） -->
                <Border Classes="card" Padding="18,14">
                  <Expander IsExpanded="{Binding HasProjectNotes}">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                          <TextBlock Text="MY NOTE" Classes="muted" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="专题研究笔记" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <Border Classes="badge-count">
                          <TextBlock Text="{Binding ProjectNotesCount}" Classes="muted" FontSize="10.5" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="记录跨文献机制对比、理论张力与综述框架（导出 Markdown 矩阵时自动包含）" Classes="tertiary" FontSize="11.5" VerticalAlignment="Center" />
                      </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,2" Spacing="12">
                      <Grid ColumnDefinitions="260,*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding DraftProjectNoteTitle, Mode=TwoWay}"
                                 PlaceholderText="笔记标题（可选，如「综述核心论点」）" />
                        <TextBox Grid.Column="1" Text="{Binding DraftProjectNoteBody, Mode=TwoWay}"
                                 PlaceholderText="写下跨文献观察或综述思路（Ctrl+Enter 快速保存）…"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110"
                                 KeyDown="DraftProjectNoteBody_KeyDown" />
                        <Button Grid.Column="2" Content="＋ 保存专题笔记" Classes="primary compact"
                                VerticalAlignment="Top" Click="SaveDraftProjectNote_Click" />
                      </Grid>

                      <ItemsControl ItemsSource="{Binding ProjectNotes}" IsVisible="{Binding HasProjectNotes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:ProjectNoteItem">
                            <Border Classes="note-card" Margin="0,0,0,8" ClipToBounds="True">
                              <Border.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="编辑专题笔记" Tag="{Binding}" Click="EditProjectNote_Click" />
                                  <MenuItem Header="复制正文" Tag="{Binding}" Click="CopyProjectNote_Click" />
                                  <Separator />
                                  <MenuItem Header="删除专题笔记" Tag="{Binding}" Click="DeleteProjectNote_Click" />
                                </ContextMenu>
                              </Border.ContextMenu>
                              <Grid ColumnDefinitions="4,*">
                                <Border Grid.Column="0" Background="{DynamicResource InkTertiaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="14,11,14,12" Spacing="6">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <WrapPanel Grid.Column="0" ItemSpacing="8" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding TimeLabel}" Classes="tertiary" FontSize="11" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                      <Button Content="编辑" Classes="secondary compact" MinHeight="24" Padding="9,1" FontSize="11" Tag="{Binding}" Click="EditProjectNote_Click" />
                                      <Button Content="删除" Classes="ghost compact" MinHeight="24" Padding="8,1" FontSize="11" Tag="{Binding}" Click="DeleteProjectNote_Click" />
                                    </StackPanel>
                                  </Grid>
                                  <TextBlock Text="{Binding Note}" FontSize="13" LineHeight="21" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </Border>

                <!-- Evidence Matrix 多维快速筛选条（大专题论文众多时一键按状态/类型/审定过滤） -->
                <Border Classes="soft-card" Padding="14,12" IsVisible="{Binding HasAnyMatrixRowsInProject}">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <WrapPanel Grid.Column="0" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                        <TextBlock Text="阅读状态" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Button Content="全部" Tag="all" Classes="scope-chip" Classes.active="{Binding IsMatrixReadingAll}" Click="MatrixReadingFilter_Click" />
                        <Button Content="核心文献" Tag="core" Classes="scope-chip" Classes.active="{Binding IsMatrixReadingCore}" Click="MatrixReadingFilter_Click" />
                        <Button Content="已复核" Tag="reviewed" Classes="scope-chip" Classes.active="{Binding IsMatrixReadingReviewed}" Click="MatrixReadingFilter_Click" />
                        <Button Content="在读" Tag="reading" Classes="scope-chip" Classes.active="{Binding IsMatrixReadingReading}" Click="MatrixReadingFilter_Click" />
                        <Button Content="待读" Tag="queued" Classes="scope-chip" Classes.active="{Binding IsMatrixReadingQueued}" Click="MatrixReadingFilter_Click" />
                      </WrapPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MatrixFilterSummary}" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                        <Button Content="重置筛选" Classes="ghost compact" MinHeight="24" Padding="8,1" FontSize="11"
                                IsVisible="{Binding HasActiveMatrixFilters}" Click="ResetMatrixFilters_Click" />
                      </StackPanel>
                    </Grid>

                    <WrapPanel ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                      <TextBlock Text="人工审定" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,2,0" />
                      <Button Content="全部" Tag="all" Classes="scope-chip" Classes.active="{Binding IsMatrixReviewAll}" Click="MatrixReviewFilter_Click" />
                      <Button Content="已人工审定" Tag="has_review" Classes="scope-chip" Classes.active="{Binding IsMatrixReviewHasReview}" Click="MatrixReviewFilter_Click" />
                      <Button Content="含人工修正" Tag="corrected" Classes="scope-chip" Classes.active="{Binding IsMatrixReviewCorrected}" Click="MatrixReviewFilter_Click" />
                      <Button Content="含存疑驳回" Tag="rejected" Classes="scope-chip" Classes.active="{Binding IsMatrixReviewRejected}" Click="MatrixReviewFilter_Click" />
                      <Button Content="尚未审定" Tag="unreviewed" Classes="scope-chip" Classes.active="{Binding IsMatrixReviewUnreviewed}" Click="MatrixReviewFilter_Click" />
                      <TextBlock Text="·  研究类型" Classes="eyebrow" VerticalAlignment="Center" Margin="8,0,2,0" />
                      <ComboBox ItemsSource="{Binding MatrixStudyTypeOptions}"
                                SelectedItem="{Binding SelectedMatrixStudyTypeOption, Mode=TwoWay}"
                                MinWidth="148" FontSize="11.5" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- 筛选后无匹配提示 -->
                <Border Classes="soft-card" Padding="26,20" IsVisible="{Binding IsMatrixFilteredEmpty}">
                  <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="当前筛选条件下没有匹配的专题文献" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                    <Button Content="重置全部筛选条件" Classes="tonal compact" HorizontalAlignment="Center" Click="ResetMatrixFilters_Click" />
                  </StackPanel>
                </Border>

                <!-- 空专题友好引导 -->
                <Border Classes="soft-card" Padding="36,30" IsVisible="{Binding IsMatrixEmpty}">
                  <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="当前研究专题还没有纳入文献" Classes="h2" HorizontalAlignment="Center" />
                    <TextBlock Text="从文献库挑选相关论文加入本专题，或对着左侧论文列表右键「归入研究专题…」，即可立刻生成跨文献对比矩阵。"
                               Classes="muted" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                    <Button Content="＋ 从文献库添加文献" Classes="primary" HorizontalAlignment="Center"
                            Click="AddPapersToActiveProject_Click" />
                  </StackPanel>
                </Border>

                <!-- 逐篇结构化证据矩阵卡片 -->
                <ItemsControl ItemsSource="{Binding MatrixRows}" IsVisible="{Binding HasMatrixRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectMatrixRowItem">
                      <Border Classes="card" Padding="20,18" Margin="0,0,0,14">
                        <StackPanel Spacing="14">
                          <!-- 顶栏：题名、阅读状态胶囊、快捷操作 -->
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="5">
                              <WrapPanel ItemSpacing="8" LineSpacing="5" VerticalAlignment="Center">
                                <Border IsVisible="{Binding IsCoreStatus}" Background="{DynamicResource PurpleSoftBrush}" BorderBrush="{DynamicResource PurpleLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding ReadingStatusLabel}" Foreground="{DynamicResource PurpleInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                                <Border IsVisible="{Binding IsReviewedStatus}" Background="{DynamicResource EmeraldSoftBrush}" BorderBrush="{DynamicResource EmeraldLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding ReadingStatusLabel}" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                                <Border IsVisible="{Binding IsReadingStatus}" Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding ReadingStatusLabel}" Foreground="{DynamicResource BlueInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                                <Border IsVisible="{Binding IsQueuedStatus}" Classes="badge" Padding="8,2">
                                  <TextBlock Text="{Binding ReadingStatusLabel}" Classes="muted" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                                <Border Classes="badge" Padding="8,2">
                                  <TextBlock Text="{Binding StudyTypeLabel}" Classes="muted" FontSize="10.5" FontWeight="Medium" />
                                </Border>
                                <Border IsVisible="{Binding HasAnyHumanReview}" Background="{DynamicResource EmeraldSoftBrush}" BorderBrush="{DynamicResource EmeraldLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding HumanReviewSummaryBadge}" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                              </WrapPanel>
                              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="23" />
                              <TextBlock Text="{Binding MetaSubtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                              <Border IsVisible="{Binding HasProjectNote}" Classes="soft-card" Padding="10,6" Margin="0,2,0,0">
                                <TextBlock Text="{Binding ProjectNote, StringFormat='专题备注：{0}'}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                              </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top">
                              <Button Content="打开精读 →" Classes="tonal compact" Tag="{Binding}" Click="MatrixOpenPaper_Click" />
                              <Button Content="状态 / 备注" Classes="secondary compact" Tag="{Binding}" Click="MatrixEditRowStatus_Click" />
                              <Button Content="移出" Classes="ghost compact" Tag="{Binding}" Click="MatrixRemoveRow_Click" ToolTip.Tip="仅从当前专题移出，不删原论文" />
                            </StackPanel>
                          </Grid>

                          <!-- 未分析文献提示 -->
                          <Border IsVisible="{Binding HasNoCard}" Classes="soft-card" Padding="14,10">
                            <TextBlock Text="该论文尚未生成 Paper Card。点击右上角「打开精读 →」运行分析后，此处将自动填充研究设计与核心证据对照。"
                                       Classes="muted" FontSize="12" TextWrapping="Wrap" />
                          </Border>

                          <!-- 已分析：研究设计四列速览 + AUTHOR / AI REVIEW 严格分离对照 -->
                          <StackPanel IsVisible="{Binding HasCard}" Spacing="12">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                              <Border Grid.Column="0" Classes="design-cell" Padding="12,10">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="研究方法" Classes="eyebrow" />
                                  <TextBlock Text="{Binding MethodSummary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                              </Border>
                              <Border Grid.Column="1" Classes="design-cell" Padding="12,10">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="识别 / 推断策略" Classes="eyebrow" />
                                  <TextBlock Text="{Binding IdentificationSummary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                              </Border>
                              <Border Grid.Column="2" Classes="design-cell" Padding="12,10">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="样本群体 / 数据源" Classes="eyebrow" />
                                  <TextBlock Text="{Binding PopulationDataSummary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                              </Border>
                            </Grid>

                            <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                              <!-- 左栏：AUTHOR 核心发现与研究问题 -->
                              <Border Grid.Column="0" Classes="soft-card" Padding="14,12">
                                <StackPanel Spacing="10">
                                  <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Border Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                      <TextBlock Text="AUTHOR" Foreground="{DynamicResource BlueInkBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="核心发现与作者机制" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                  </StackPanel>

                                  <ItemsControl ItemsSource="{Binding MajorFindings}" IsVisible="{Binding HasMajorFindings}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="models:MatrixClaimItem">
                                        <StackPanel Spacing="5" Margin="0,0,0,9">
                                          <TextBlock Text="{Binding Statement}" FontSize="13" LineHeight="21" TextWrapping="Wrap" />
                                          <Border IsVisible="{Binding HasHumanCorrectedStatement}" Classes="human-correction-block" Padding="10,7">
                                            <TextBlock Text="{Binding HumanCorrectedStatement, StringFormat='✎ 人工修正：{0}'}"
                                                       FontSize="12.5" FontWeight="Medium" LineHeight="19" TextWrapping="Wrap" />
                                          </Border>
                                          <WrapPanel ItemSpacing="6" LineSpacing="5">
                                            <Border IsVisible="{Binding IsHumanConfirmed}" Background="{DynamicResource EmeraldSoftBrush}" BorderBrush="{DynamicResource EmeraldLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding HumanReviewBadgeLabel}" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsHumanCorrected}" Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding HumanReviewBadgeLabel}" Foreground="{DynamicResource BlueInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsHumanRejected}" Background="{DynamicResource RedSoftBrush}" BorderBrush="{DynamicResource RedLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding HumanReviewBadgeLabel}" Foreground="{DynamicResource RedInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsHumanUnresolved}" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding HumanReviewBadgeLabel}" Foreground="{DynamicResource AmberInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsAuditPositive}" Background="{DynamicResource EmeraldSoftBrush}" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding AuditBadgeLabel}" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsAuditWarning}" Background="{DynamicResource AmberSoftBrush}" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding AuditBadgeLabel}" Foreground="{DynamicResource AmberInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsAuditNegative}" Background="{DynamicResource RedSoftBrush}" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding AuditBadgeLabel}" Foreground="{DynamicResource RedInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Citations}" IsVisible="{Binding HasCitations}">
                                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="5" LineSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                              <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:MatrixCitationItem">
                                                  <Button Content="{Binding BadgeLabel}" Classes="tonal compact"
                                                          MinHeight="22" Padding="8,1" FontSize="10.5"
                                                          Tag="{Binding}" Click="MatrixCitationJump_Click"
                                                          ToolTip.Tip="{Binding TooltipText}" />
                                                </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                          </WrapPanel>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <ItemsControl ItemsSource="{Binding AuthorExplanations}" IsVisible="{Binding HasAuthorExplanations}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="models:MatrixClaimItem">
                                        <StackPanel Spacing="4" Margin="0,0,0,6">
                                          <TextBlock Text="{Binding Statement, StringFormat='机制解释：{0}'}" Classes="muted" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>

                              <!-- 右栏：AI REVIEW 方法学局限与边界 -->
                              <Border Grid.Column="1" Classes="soft-card" Padding="14,12">
                                <StackPanel Spacing="10">
                                  <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Border Background="{DynamicResource PurpleSoftBrush}" BorderBrush="{DynamicResource PurpleLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                      <TextBlock Text="AI REVIEW" Foreground="{DynamicResource PurpleInkBrush}" FontSize="9.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="方法学局限与审读提示" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                  </StackPanel>

                                  <ItemsControl ItemsSource="{Binding AiLimitations}" IsVisible="{Binding HasAiLimitations}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="models:MatrixClaimItem">
                                        <StackPanel Spacing="4" Margin="0,0,0,8">
                                          <TextBlock Text="{Binding Statement, StringFormat='• {0}'}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap" />
                                          <Border IsVisible="{Binding HasHumanCorrectedStatement}" Classes="human-correction-block" Padding="9,6">
                                            <TextBlock Text="{Binding HumanCorrectedStatement, StringFormat='✎ 人工修正：{0}'}"
                                                       FontSize="12" FontWeight="Medium" LineHeight="18" TextWrapping="Wrap" />
                                          </Border>
                                          <WrapPanel IsVisible="{Binding HasHumanReview}" ItemSpacing="5" LineSpacing="4">
                                            <Border IsVisible="{Binding IsHumanConfirmed}" Background="{DynamicResource EmeraldSoftBrush}" BorderBrush="{DynamicResource EmeraldLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding HumanReviewBadgeLabel}" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsHumanCorrected}" Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding HumanReviewBadgeLabel}" Foreground="{DynamicResource BlueInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsHumanRejected}" Background="{DynamicResource RedSoftBrush}" BorderBrush="{DynamicResource RedLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding HumanReviewBadgeLabel}" Foreground="{DynamicResource RedInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border IsVisible="{Binding IsHumanUnresolved}" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="999" Padding="7,2">
                                              <TextBlock Text="{Binding HumanReviewBadgeLabel}" Foreground="{DynamicResource AmberInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                          </WrapPanel>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <ItemsControl ItemsSource="{Binding AuthorLimitations}" IsVisible="{Binding HasAuthorLimitations}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="models:MatrixClaimItem">
                                        <TextBlock Text="{Binding Statement, StringFormat='[作者自述] {0}'}" Classes="muted" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,5" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </Grid>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- C. 跨论文 / 专题级 SQLite FTS5 全文检索面板（点击命中直跳论文、PDF 原页或我的笔记） -->
          <Border Classes="workspace-surface" Margin="12,12,12,14" IsVisible="{Binding ShowSearchPanelView}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="28,24,28,48" Spacing="18" MaxWidth="980" HorizontalAlignment="Center">
                <Border Classes="card" Padding="20,18">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="FULL-TEXT SEARCH · SQLite FTS5 跨文献双语检索" Classes="eyebrow" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="一次穿透 PDF 原文、Paper Card 主张、个人笔记（MY NOTE）与人工审定记录（HUMAN REVIEWED），点击任意命中直跳对应位置。"
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="← 返回阅读" Classes="ghost compact" VerticalAlignment="Top"
                              Click="CloseFullTextSearch_Click" />
                    </Grid>

                    <!-- 大号检索输入框 -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBox x:Name="FullTextSearchInput" Grid.Column="0"
                               Text="{Binding FullTextQuery, Mode=TwoWay}"
                               KeyDown="FullTextSearchInput_KeyDown"
                               PlaceholderText="输入中文术语、英文词干、作者或笔记关键词，回车执行检索…" />
                      <Button Grid.Column="1" Content="清空" Classes="ghost"
                              Click="ClearFullTextSearch_Click" />
                      <Button Grid.Column="2" Content="检索" Classes="primary"
                              Click="RunFullTextSearch_Click" />
                    </Grid>

                    <!-- 作用范围 + 来源类型筛选芯片 -->
                    <StackPanel Spacing="8">
                      <WrapPanel IsVisible="{Binding CanToggleProjectSearchScope}" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                        <TextBlock Text="检索范围" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Content="{Binding ActiveProjectName, StringFormat='仅当前专题：{0}'}"
                                Classes="scope-chip" Classes.active="{Binding IsSearchingProjectScope}"
                                Click="SearchScopeProject_Click" />
                        <Button Content="全部文献库"
                                Classes="scope-chip" Classes.active="{Binding IsSearchingAllLibrary}"
                                Click="SearchScopeAll_Click" />
                      </WrapPanel>

                      <WrapPanel ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                        <TextBlock Text="来源筛选" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Content="全部来源" Tag="ALL" Classes="scope-chip" Classes.active="{Binding IsSourceFilterAll}" Click="SearchSourceFilter_Click" />
                        <Button Content="PDF 原文" Tag="SOURCE_BLOCK" Classes="scope-chip" Classes.active="{Binding IsSourceFilterSourceBlock}" Click="SearchSourceFilter_Click" />
                        <Button Content="Paper Card" Tag="PAPER_CARD" Classes="scope-chip" Classes.active="{Binding IsSourceFilterPaperCard}" Click="SearchSourceFilter_Click" />
                        <Button Content="我的笔记 (全部)" Tag="USER_NOTE" Classes="scope-chip" Classes.active="{Binding IsSourceFilterUserNote}" Click="SearchSourceFilter_Click" />
                        <Button Content="专题笔记" Tag="PROJECT_NOTE" Classes="scope-chip" Classes.active="{Binding IsSourceFilterProjectNote}" Click="SearchSourceFilter_Click" />
                        <Button Content="人工审定 / 复核" Tag="HUMAN_REVIEWED" Classes="scope-chip" Classes.active="{Binding IsSourceFilterHumanReviewed}" Click="SearchSourceFilter_Click" />
                        <Button Content="书目元数据" Tag="METADATA" Classes="scope-chip" Classes.active="{Binding IsSourceFilterMetadata}" Click="SearchSourceFilter_Click" />
                      </WrapPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding FullTextStatusLine}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <!-- 初始引导 -->
                <Border Classes="soft-card" Padding="32,26" IsVisible="{Binding IsFullTextPromptVisible}">
                  <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="输入关键词开始跨文献溯源检索" Classes="h2" HorizontalAlignment="Center" />
                    <TextBlock Text="支持中文短语（如“双重差分”“算法控制”）、英文前缀（如 identif 匹配 identification）以及你写下的个人笔记和人工修正表述。"
                               Classes="muted" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                  </StackPanel>
                </Border>

                <!-- 无结果提示 -->
                <Border Classes="soft-card" Padding="28,22" IsVisible="{Binding HasNoFullTextHits}">
                  <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="未找到匹配的原文、主张或笔记片段" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Text="可以尝试切换来源筛选为「全部来源」，或将范围切换至「全部文献库」。" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- 可溯源命中片段列表 -->
                <ItemsControl ItemsSource="{Binding FullTextHits}" IsVisible="{Binding HasFullTextHits}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SearchHitItem">
                      <Border Classes="claim-card" Margin="0,0,0,12" ClipToBounds="True">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="直达对应位置" Tag="{Binding}" Click="SearchHitPrimaryJump_Click" />
                            <MenuItem Header="定位 PDF 原页" IsVisible="{Binding CanJumpPdf}" Tag="{Binding}" Click="SearchHitJumpPdf_Click" />
                            <MenuItem Header="打开论文精读" IsVisible="{Binding IsPaperTarget}" Tag="{Binding}" Click="SearchHitOpenPaper_Click" />
                            <MenuItem Header="打开论文「我的笔记」" IsVisible="{Binding IsPaperTarget}" Tag="{Binding}" Click="SearchHitOpenNotes_Click" />
                            <Separator />
                            <MenuItem Header="复制命中片段与来源" Tag="{Binding}" Click="SearchHitCopySnippet_Click" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Grid ColumnDefinitions="4,*">
                          <Border Grid.Column="0" IsVisible="{Binding IsSourceBlock}" Background="{DynamicResource BlueInkBrush}" />
                          <Border Grid.Column="0" IsVisible="{Binding IsCardAuthor}" Background="{DynamicResource BlueInkBrush}" />
                          <Border Grid.Column="0" IsVisible="{Binding IsCardAi}" Background="{DynamicResource PurpleInkBrush}" />
                          <Border Grid.Column="0" IsVisible="{Binding IsAnyNote}" Background="{DynamicResource InkTertiaryBrush}" />
                          <Border Grid.Column="0" IsVisible="{Binding IsHumanReviewed}" Background="{DynamicResource EmeraldInkBrush}" />
                          <Border Grid.Column="0" IsVisible="{Binding IsMetadata}" Background="{DynamicResource AmberInkBrush}" />

                          <StackPanel Grid.Column="1" Margin="18,14,18,15" Spacing="9">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                              <WrapPanel Grid.Column="0" ItemSpacing="7" LineSpacing="4" VerticalAlignment="Center">
                                <Border IsVisible="{Binding IsSourceBlock}" Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding SourceKindLabel}" Foreground="{DynamicResource BlueInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <Border IsVisible="{Binding IsCardAuthor}" Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding SourceKindLabel}" Foreground="{DynamicResource BlueInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <Border IsVisible="{Binding IsCardAi}" Background="{DynamicResource PurpleSoftBrush}" BorderBrush="{DynamicResource PurpleLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding SourceKindLabel}" Foreground="{DynamicResource PurpleInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <Border IsVisible="{Binding IsAnyNote}" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding SourceKindLabel}" Classes="muted" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <Border IsVisible="{Binding IsHumanReviewed}" Background="{DynamicResource EmeraldSoftBrush}" BorderBrush="{DynamicResource EmeraldLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding SourceKindLabel}" Foreground="{DynamicResource EmeraldInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <Border IsVisible="{Binding IsMetadata}" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                  <TextBlock Text="{Binding SourceKindLabel}" Foreground="{DynamicResource AmberInkBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding PaperTitle}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border IsVisible="{Binding HasPageNumber}" Classes="badge" Padding="7,2">
                                  <TextBlock Text="{Binding PageBadgeLabel}" Classes="muted" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                              </WrapPanel>

                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                <Button IsVisible="{Binding ShowSecondaryPdfButton}"
                                        Content="{Binding SecondaryPdfJumpLabel}"
                                        Classes="secondary compact" MinHeight="26" Padding="9,2" FontSize="11"
                                        Tag="{Binding}" Click="SearchHitJumpPdf_Click" />
                                <Button Content="{Binding PrimaryJumpLabel}"
                                        Classes="tonal compact" MinHeight="26" Padding="10,2" FontSize="11"
                                        Tag="{Binding}" Click="SearchHitPrimaryJump_Click" />
                              </StackPanel>
                            </Grid>

                            <controls:HighlightedSnippetText SnippetText="{Binding Snippet}"
                                                             HighlightQuery="{Binding HighlightQuery}"
                                                             FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- D. 基于已审定证据矩阵的多文献综合工作区（Consensus / Conflict / Methodological Divergence / Gaps） -->
          <Border Classes="workspace-surface" Margin="12,12,12,14" IsVisible="{Binding ShowProjectSynthesisView}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="28,24,28,52" Spacing="18" MaxWidth="1020" HorizontalAlignment="Center">
                <!-- 顶部控制卡：参数选项、显式预览触发与历史快照切换 -->
                <Border Classes="card" Padding="20,18">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <StackPanel Spacing="4">
                        <WrapPanel ItemSpacing="8" VerticalAlignment="Center">
                          <Border Background="{DynamicResource PurpleSoftBrush}" BorderBrush="{DynamicResource PurpleLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                            <TextBlock Text="AI_INFERRED_SYNTHESIS" Foreground="{DynamicResource PurpleInkBrush}" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.4" />
                          </Border>
                          <TextBlock Text="基于已审定证据矩阵的多文献综合" Classes="section-title" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="优先采纳你的「人工修正（HUMAN_REVIEWED）」表述，自动剔除已标为「存疑驳回」的主张；外发前必经透明预检与双重确认，所有结论强制溯源至原论文 PDF 页码，以不可变快照独立归档。"
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="预览并发起跨文献综合" Classes="primary"
                              VerticalAlignment="Top" IsEnabled="{Binding !IsRunningSynthesis}"
                              Click="PreviewAndRunSynthesis_Click" />
                    </Grid>

                    <!-- 可选参数：严格模式 / 附带专题笔记 / 聚焦指令 -->
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                      <CheckBox Grid.Column="0" Content="仅纳入已人工确认 / 修正主张（严格模式）"
                                IsChecked="{Binding SynthesisOnlyReviewed, Mode=TwoWay}" FontSize="12" />
                      <CheckBox Grid.Column="1" Content="附带专题研究笔记"
                                IsChecked="{Binding SynthesisIncludeProjectNotes, Mode=TwoWay}" FontSize="12" />
                      <TextBox Grid.Column="2" Text="{Binding SynthesisFocusInstruction, Mode=TwoWay}"
                               PlaceholderText="可选：聚焦比较维度（如「重点比较城乡样本与因果识别策略分歧」）" />
                    </Grid>

                    <!-- 执行中进度条与状态反馈 -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsRunningSynthesis}">
                      <ProgressBar IsIndeterminate="True" Height="4" />
                    </StackPanel>
                    <Border IsVisible="{Binding HasSynthesisStatusMessage}" Classes="tonal-card" Padding="12,8">
                      <TextBlock Text="{Binding SynthesisStatusMessage}" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- 历史不可变快照切换 + 复制 / 导出 / 删除 -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding HasSynthesisHistory}">
                      <TextBlock Grid.Column="0" Text="历史综合快照" Classes="eyebrow" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding ProjectSyntheses}"
                                SelectedItem="{Binding SelectedSynthesisSummary, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                      <Button Grid.Column="2" Content="复制 MD" Classes="tonal compact"
                              IsEnabled="{Binding HasActiveSynthesis}" Click="CopyActiveSynthesisMarkdown_Click" />
                      <Button Grid.Column="3" Content="导出报告 (MD)" Classes="secondary compact"
                              IsEnabled="{Binding HasActiveSynthesis}" Click="ExportActiveSynthesisMarkdown_Click" />
                      <Button Grid.Column="4" Content="删除快照" Classes="ghost compact"
                              IsEnabled="{Binding HasActiveSynthesis}" Click="DeleteActiveSynthesis_Click" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- 空态引导 -->
                <Border Classes="soft-card" Padding="36,28" IsVisible="{Binding HasNoActiveSynthesis}">
                  <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="540">
                    <TextBlock Text="当前专题尚未生成跨文献综合快照" Classes="h2" HorizontalAlignment="Center" />
                    <TextBlock Text="确保本专题至少包含 2 篇已生成 Paper Card 的论文；建议先在精读页对关键发现完成「✓ 确认 / ✎ 修正 / ✕ 存疑驳回」，然后点击右上角「预览并发起跨文献综合」。"
                               Classes="muted" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" />
                    <Button Content="预览并发起跨文献综合" Classes="primary" HorizontalAlignment="Center"
                            Click="PreviewAndRunSynthesis_Click" />
                  </StackPanel>
                </Border>

                <!-- 活跃综合快照：总体图景 + 四维可溯源卡片流 -->
                <StackPanel Spacing="20" IsVisible="{Binding HasActiveSynthesis}">
                  <Border Classes="reading-lead" Padding="22,18">
                    <StackPanel Spacing="8">
                      <WrapPanel ItemSpacing="8" VerticalAlignment="Center">
                        <TextBlock Text="总体研究图景" Classes="section-title" VerticalAlignment="Center" />
                        <Border Classes="badge" Padding="8,2">
                          <TextBlock Text="{Binding ActiveSynthesisAuditStats}" Classes="muted" FontSize="10.5" FontWeight="Medium" />
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding ActiveSynthesisExecutiveSummary}" FontSize="14" LineHeight="24" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <!-- 1. 研究共识 -->
                  <StackPanel Spacing="10" IsVisible="{Binding HasSynthesisConsensus}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="一、研究共识（Consensus）" Classes="section-title" />
                      <Border Classes="badge-count"><TextBlock Text="{Binding SynthesisConsensusCount}" Classes="muted" FontSize="11" FontWeight="SemiBold" /></Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SynthesisConsensus}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SynthesisPointItem">
                          <Border Classes="claim-card" Margin="0,0,0,10" ClipToBounds="True">
                            <Grid ColumnDefinitions="4,*">
                              <Border Grid.Column="0" Background="{DynamicResource EmeraldInkBrush}" />
                              <StackPanel Grid.Column="1" Margin="18,14,18,15" Spacing="9">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SupportingClaims}" IsVisible="{Binding HasSupportingClaims}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SynthesisClaimCitationItem">
                                      <Button Content="{Binding ChipLabel}" Classes="tonal compact" MinHeight="24" Padding="9,2" FontSize="11"
                                              Tag="{Binding}" Click="SynthesisCitationJump_Click" ToolTip.Tip="{Binding TooltipText}">
                                        <Button.ContextMenu>
                                          <ContextMenu>
                                            <MenuItem Header="定位 PDF 原页高亮" IsVisible="{Binding HasPageNumber}" Tag="{Binding}" Click="SynthesisCitationJump_Click" />
                                            <MenuItem Header="打开论文精读" Tag="{Binding}" Click="SynthesisCitationOpenPaper_Click" />
                                          </ContextMenu>
                                        </Button.ContextMenu>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- 2. 核心分歧、冲突与限定条件 -->
                  <StackPanel Spacing="10" IsVisible="{Binding HasSynthesisConflicts}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="二、核心分歧、冲突与限定条件（Conflicts &amp; Scope Conditions）" Classes="section-title" />
                      <Border Classes="badge-count"><TextBlock Text="{Binding SynthesisConflictsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold" /></Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SynthesisConflicts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SynthesisPointItem">
                          <Border Classes="claim-card" Margin="0,0,0,10" ClipToBounds="True">
                            <Grid ColumnDefinitions="4,*">
                              <Border Grid.Column="0" Background="{DynamicResource RedInkBrush}" />
                              <StackPanel Grid.Column="1" Margin="18,14,18,15" Spacing="9">
                                <WrapPanel ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                  <Border IsVisible="{Binding HasDivergenceAxis}" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                    <TextBlock Text="{Binding DivergenceAxis, StringFormat='分歧维度：{0}'}" Foreground="{DynamicResource AmberInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                  </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding Summary}" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SupportingClaims}" IsVisible="{Binding HasSupportingClaims}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SynthesisClaimCitationItem">
                                      <Button Content="{Binding ChipLabel}" Classes="tonal compact" MinHeight="24" Padding="9,2" FontSize="11"
                                              Tag="{Binding}" Click="SynthesisCitationJump_Click" ToolTip.Tip="{Binding TooltipText}">
                                        <Button.ContextMenu>
                                          <ContextMenu>
                                            <MenuItem Header="定位 PDF 原页高亮" IsVisible="{Binding HasPageNumber}" Tag="{Binding}" Click="SynthesisCitationJump_Click" />
                                            <MenuItem Header="打开论文精读" Tag="{Binding}" Click="SynthesisCitationOpenPaper_Click" />
                                          </ContextMenu>
                                        </Button.ContextMenu>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- 3. 方法论谱系与识别策略对比 -->
                  <StackPanel Spacing="10" IsVisible="{Binding HasSynthesisMethodDifferences}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="三、方法论谱系与识别策略对比（Methodological Divergence）" Classes="section-title" />
                      <Border Classes="badge-count"><TextBlock Text="{Binding SynthesisMethodDifferencesCount}" Classes="muted" FontSize="11" FontWeight="SemiBold" /></Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SynthesisMethodDifferences}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SynthesisPointItem">
                          <Border Classes="claim-card" Margin="0,0,0,10" ClipToBounds="True">
                            <Grid ColumnDefinitions="4,*">
                              <Border Grid.Column="0" Background="{DynamicResource BlueInkBrush}" />
                              <StackPanel Grid.Column="1" Margin="18,14,18,15" Spacing="9">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SupportingClaims}" IsVisible="{Binding HasSupportingClaims}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SynthesisClaimCitationItem">
                                      <Button Content="{Binding ChipLabel}" Classes="tonal compact" MinHeight="24" Padding="9,2" FontSize="11"
                                              Tag="{Binding}" Click="SynthesisCitationJump_Click" ToolTip.Tip="{Binding TooltipText}">
                                        <Button.ContextMenu>
                                          <ContextMenu>
                                            <MenuItem Header="定位 PDF 原页高亮" IsVisible="{Binding HasPageNumber}" Tag="{Binding}" Click="SynthesisCitationJump_Click" />
                                            <MenuItem Header="打开论文精读" Tag="{Binding}" Click="SynthesisCitationOpenPaper_Click" />
                                          </ContextMenu>
                                        </Button.ContextMenu>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- 4. 研究缺口与潜在 Puzzle -->
                  <StackPanel Spacing="10" IsVisible="{Binding HasSynthesisResearchGaps}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="四、研究缺口与潜在 Puzzle（Research Gaps）" Classes="section-title" />
                      <Border Classes="badge-count"><TextBlock Text="{Binding SynthesisResearchGapsCount}" Classes="muted" FontSize="11" FontWeight="SemiBold" /></Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SynthesisResearchGaps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SynthesisPointItem">
                          <Border Classes="claim-card" Margin="0,0,0,10" ClipToBounds="True">
                            <Grid ColumnDefinitions="4,*">
                              <Border Grid.Column="0" Background="{DynamicResource PurpleInkBrush}" />
                              <StackPanel Grid.Column="1" Margin="18,14,18,15" Spacing="9">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SupportingClaims}" IsVisible="{Binding HasSupportingClaims}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SynthesisClaimCitationItem">
                                      <Button Content="{Binding ChipLabel}" Classes="tonal compact" MinHeight="24" Padding="9,2" FontSize="11"
                                              Tag="{Binding}" Click="SynthesisCitationJump_Click" ToolTip.Tip="{Binding TooltipText}">
                                        <Button.ContextMenu>
                                          <ContextMenu>
                                            <MenuItem Header="定位 PDF 原页高亮" IsVisible="{Binding HasPageNumber}" Tag="{Binding}" Click="SynthesisCitationJump_Click" />
                                            <MenuItem Header="打开论文精读" Tag="{Binding}" Click="SynthesisCitationOpenPaper_Click" />
                                          </ContextMenu>
                                        </Button.ContextMenu>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- 5. 局限与待核查边界 -->
                  <Border Classes="soft-card" Padding="18,14" IsVisible="{Binding HasSynthesisLimitations}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="五、本次综合局限与待核查边界" FontWeight="SemiBold" FontSize="14" />
                      <ItemsControl ItemsSource="{Binding SynthesisLimitations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:CompileBindings="False">
                            <TextBlock Text="{Binding StringFormat='• {0}'}" Classes="muted" FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,4" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
      </DockPanel>

      <!-- Books -->
      <Grid x:Name="BooksPage" Grid.Column="1" IsVisible="False" Background="{DynamicResource CanvasBrush}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="书籍理解" Classes="display" HorizontalAlignment="Center" />
          <TextBlock Text="这里会成为 Book / Chapter / Reading Session 工作区。v0.1 先保留入口，不伪装成已经完成的功能。" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Projects -->
      <Grid x:Name="ProjectsPage" Grid.Column="1" IsVisible="False" Background="{DynamicResource CanvasBrush}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="研究项目" Classes="display" HorizontalAlignment="Center" />
          <TextBlock Text="后续将承载 Reading List、Evidence Matrix、多论文比较与 Literature Review。" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Tasks / dashboard, now a page instead of a modal -->
      <Grid x:Name="TasksPage" Grid.Column="1" IsVisible="False" RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
        <Border Grid.Row="0" Classes="page-header" Padding="30,24">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4"><TextBlock Text="任务中心" Classes="display"/><TextBlock Text="批量处理、队列状态与最近一次任务输出。" Classes="muted"/></StackPanel>
            <Button Grid.Column="1" Content="刷新" Classes="secondary compact" Click="RefreshDashboard_Click" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="30" MaxWidth="1080" Spacing="18">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="论文" Classes="eyebrow"/><TextBlock Text="{Binding DashboardPapers}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="1" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="已分析" Classes="eyebrow"/><TextBlock Text="{Binding DashboardAnalyzed}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="2" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="待分析" Classes="eyebrow"/><TextBlock Text="{Binding DashboardPending}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="3" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="待复核" Classes="eyebrow"/><TextBlock Text="{Binding DashboardReview}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="4" Classes="metric-card" Padding="16"><StackPanel><TextBlock Text="参考文献" Classes="eyebrow"/><TextBlock Text="{Binding DashboardReferences}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="批量工作流" Classes="h2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="分析待处理论文" Classes="primary" Click="BatchAnalyzePage_Click" />
                  <Button Content="批量提取参考文献" Classes="tonal" Click="BatchReferencesPage_Click" />
                  <Button Content="取消当前任务" Classes="danger" Click="CancelJob_Click" IsVisible="{Binding CanCancelJob}" />
                </StackPanel>
                <TextBox Text="{Binding DashboardOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240" FontFamily="Consolas" FontSize="10" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Health / maintenance -->
      <Grid x:Name="HealthPage" Grid.Column="1" IsVisible="False" RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
        <Border Grid.Row="0" Classes="page-header" Padding="30,24">
          <StackPanel Spacing="4"><TextBlock Text="数据与健康" Classes="display"/><TextBlock Text="检查 SQLite、PDF 存储、重复记录和模型缓存。" Classes="muted"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="30" MaxWidth="980" Spacing="16">
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="研究库安全备份与校验" Classes="h2" />
                <TextBlock Text="使用 SQLite 在线快照导出 WAL 一致性 .zip 备份包，完整保留所有论文卡片、个人笔记、人工审定、专题矩阵与多文献综合快照。严守安全边界：绝不导出任何 API Key 或凭据；跨设备恢复请先退出桌面端后执行 sra restore-backup。"
                           Classes="muted" TextWrapping="Wrap" LineHeight="19" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Content="导出轻量备份 (.zip · 数据库+笔记+审定)" Classes="primary" Click="ExportLiteBackup_Click" />
                  <Button Content="导出完整归档 (.zip · 含全部 PDF)" Classes="tonal" Click="ExportFullBackup_Click" />
                  <Button Content="校验备份包完整性 (.zip)" Classes="secondary" Click="VerifyBackup_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Repository Doctor" Classes="h2" />
                <TextBlock Text="快速检查不会重新读取每个 PDF；深度检查会额外验证文件哈希。" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="快速检查" Classes="primary" Click="QuickDoctorPage_Click" />
                  <Button Content="深度检查" Classes="tonal" Click="DeepDoctorPage_Click" />
                  <Button Content="预览缓存清理" Classes="secondary" Click="PreviewPrunePage_Click" />
                  <Button Content="清理旧缓存" Classes="danger" Click="ApplyPrunePage_Click" />
                </StackPanel>
                <TextBox Text="{Binding MaintenanceOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="360" FontFamily="Consolas" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Settings, inspired by Clash-style in-place preference pages -->
      <Grid x:Name="SettingsPage" Grid.Column="1" IsVisible="False" RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
        <Border Grid.Row="0" Classes="page-header" Padding="30,24">
          <StackPanel Spacing="4"><TextBlock Text="设置" Classes="display"/><TextBlock Text="外观、阅读工作区与模型连接。修改后保存在本机。" Classes="muted"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30" MaxWidth="980" Spacing="16">
            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4"><TextBlock Text="外观" Classes="h2"/><TextBlock Text="跟随系统或固定明暗主题。" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="14">
                  <Grid ColumnDefinitions="*,240" ColumnSpacing="20"><StackPanel Spacing="3"><TextBlock Text="主题" FontWeight="SemiBold"/><TextBlock Text="深色 / 浅色 / 跟随 Windows。" Classes="muted" FontSize="10"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode, Mode=TwoWay}"/></Grid>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
                  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="右侧研究画像" FontWeight="SemiBold"/><TextBlock Text="在论文阅读页显示 Inspector。" Classes="muted" FontSize="10"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding ShowInspector}" VerticalAlignment="Center"/></Grid>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Single source of model configuration: the Model Center.
                 Keep old settings in the backend for migration but never show
                 two independent editors for the same Lite/Pro/Vision stages. -->
            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="模型与网络" Classes="h2"/>
                  <TextBlock Text="统一管理 AI 服务商、模型和本地 PDF 模型。" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                  <TextBlock Text="在一个窗口内选择 Lite / Pro / Vision 当前生效的配置，设置 API Key、模型参数、网络代理、Docling 权重与公式/图片增强。" Classes="muted" TextWrapping="Wrap"/>
                  <TextBlock Text="原有 API 连接继续有效；首次使用时可在模型中心导入旧配置。不需要重新填写密钥。" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  <Button x:Name="ModelCenterLaunchButton" Content="打开模型配置中心" Classes="primary" HorizontalAlignment="Left"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="更新与安装" Classes="h2"/>
                  <TextBlock Text="检查新版本，并从官方 GitHub Release 安装。" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="3">
                      <TextBlock Text="启动时自动检查更新" FontWeight="SemiBold"/>
                      <TextBlock Text="仅请求公开的版本信息，不上传论文或 API Key。" Classes="muted" FontSize="10"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding CheckForUpdatesAtStartup, Mode=TwoWay}" VerticalAlignment="Center"/>
                  </Grid>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="3">
                      <TextBlock Text="允许预发布版本" FontWeight="SemiBold"/>
                      <TextBlock Text="开启后也会提示 alpha/beta/rc 版本。" Classes="muted" FontSize="10"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="{Binding InstalledDesktopVersion}" Classes="muted" FontSize="11"/>
                  <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" FontSize="11"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="检查更新" Classes="tonal" Click="CheckForUpdates_Click"/>
                    <Button Content="打开发布页面" Classes="secondary" Click="OpenUpdateRelease_Click" IsEnabled="{Binding CanOpenUpdateRelease}"/>
                  </StackPanel>
                  <TextBlock Text="目前采用自动检测 + 用户确认安装。Windows 安装器可正常卸载，卸载默认不删除本人的 PDF、数据库和 API Key。" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Storage management: the paths are returned by the running
                 Python backend; never guess a PDF location from the UI. -->
            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="存储与卸载" Classes="h2"/>
                  <TextBlock Text="准确查看程序、论文库、设置与缓存的位置。" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                  <TextBlock Text="程序安装位置" FontWeight="SemiBold"/>
                  <TextBlock x:Name="InstalledProgramPathText" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  <Button Content="打开程序目录" HorizontalAlignment="Left" Classes="secondary" Click="OpenProgramDir_Click"/>
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"/>
                  <TextBlock Text="研究数据：PDF / SQLite / 笔记" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DataStoragePathText" FontSize="11" TextWrapping="Wrap" Classes="muted" Text="正在获取路径..."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开研究库" Classes="secondary" Click="OpenDataDir_Click"/>
                    <Button Content="打开配置目录" Classes="secondary" Click="OpenConfigDir_Click"/>
                  </StackPanel>
                  <TextBlock Text="模型缓存（SRA 管理）" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CacheStoragePathText" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  <TextBlock Text="本地解析引擎（SRA 管理）" FontWeight="SemiBold"/>
                  <TextBlock x:Name="EngineStoragePathText" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开缓存目录" Classes="secondary" Click="OpenCacheDir_Click"/>
                    <Button Content="打开引擎目录" Classes="secondary" Click="OpenEngineDir_Click"/>
                    <Button Content="刷新占用信息" Classes="ghost" Click="RefreshStorage_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="StorageSizeText" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Padding="12">
                    <TextBlock Text="普通卸载仅移除程序。Windows 交互式卸载可选择清除当前账户的 SRA 专属目录；不会删除其他文件夹里的原始 PDF 或自定义研究库。macOS 请参见清理说明。外部模型缓存不保证能由 SRA 卸载器清除。" FontSize="11" TextWrapping="Wrap" Classes="muted"/>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="settings-card" Padding="22">
              <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                <StackPanel Spacing="4"><TextBlock Text="工作区" Classes="h2"/><TextBlock Text="桌面端只通过 localhost API 调用研究核心。" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="10">
                  <Grid ColumnDefinitions="150,*"><TextBlock Text="Local API" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="http://127.0.0.1:8766/api/v1"/></Grid>
                  <Grid ColumnDefinitions="150,*"><TextBlock Text="Desktop" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="{Binding InstalledDesktopVersion}"/></Grid>
                  <Grid ColumnDefinitions="150,*"><TextBlock Text="Core" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="Paper Understanding v2.2"/></Grid>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

    </Grid>

    <Border Grid.Row="2" Classes="statusbar" Padding="14,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="6.5" Height="6.5" IsVisible="{Binding IsApiConnected}"
                   Fill="{DynamicResource EmeraldInkBrush}" VerticalAlignment="Center" />
          <Ellipse Width="6.5" Height="6.5" IsVisible="{Binding !IsApiConnected}"
                   Fill="{DynamicResource AmberInkBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ApiStatusText}" Classes="tertiary" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="·" Classes="tertiary" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="SRA · Local-first" Classes="tertiary" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- MD3 拖放导入蒙层：支持将单个/多个 PDF 或文件夹直接拖入窗口 -->
    <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3"
            IsVisible="False" IsHitTestVisible="False"
            Background="#78000000" ZIndex="100">
      <Border Classes="drop-overlay-card" Padding="42,32" MaxWidth="460"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <Border Width="52" Height="52" CornerRadius="26"
                  Background="{DynamicResource TonalFillBrush}" HorizontalAlignment="Center">
            <PathIcon Width="24" Height="24" Foreground="{DynamicResource OnTonalFillBrush}"
                      Data="M12 3L7 8H10.5V14.5H13.5V8H17L12 3ZM5 17.5V19.5H19V17.5H5Z" />
          </Border>
          <TextBlock Text="释放以导入 PDF 文献" Classes="h1" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding DropOverlaySubtitle}"
                     Classes="muted" FontSize="13" LineHeight="20"
                     TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
