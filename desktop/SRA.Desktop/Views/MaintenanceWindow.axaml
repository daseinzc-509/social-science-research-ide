<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SRA.Desktop.Views.MaintenanceWindow"
        Title="数据库健康"
        Width="820"
        Height="620"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*" Margin="22">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="数据库健康" Classes="h1" />
      <TextBlock Text="检查 SQLite、PDF 文件、Card、source blocks 与模型缓存。清理缓存不会删除 PDF 或 Paper Card。" Classes="muted" TextWrapping="Wrap" FontSize="11" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Button Content="快速检查" Classes="secondary" Click="QuickCheck_Click" />
      <Button Content="深度检查" Classes="secondary" Click="DeepCheck_Click" />
      <Button Content="预览旧缓存" Classes="secondary" Click="PreviewPrune_Click" />
      <Button Content="清理旧缓存" Classes="danger" Click="ApplyPrune_Click" />
    </StackPanel>

    <Border Grid.Row="2" Classes="soft-card" Padding="12">
      <TextBox x:Name="OutputBox" Text="正在检查…" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="10"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Border>
  </Grid>
</Window>
