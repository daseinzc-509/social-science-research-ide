<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SRA.Desktop.Views.MetadataWindow"
        Title="编辑书目信息"
        Width="740"
        Height="740"
        MinWidth="650"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="page-header" Padding="24,18">
      <StackPanel Spacing="4">
        <TextBlock Text="编辑书目信息" Classes="h1" />
        <TextBlock Text="手动修订独立保存在本地数据库中，后续重新分析不会覆盖；恢复自动提取将清除全部手动修订。" Classes="muted" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20" Spacing="14">
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="5"><TextBlock Text="期刊" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="JournalBox"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="年份" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="YearBox"/></StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="5"><TextBlock Text="卷" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="VolumeBox" PlaceholderText="没有可留空"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="期" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="IssueBox"/></StackPanel>
              <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="页码" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="PagesBox" PlaceholderText="例如 114-140"/></StackPanel>
            </Grid>
            <StackPanel Spacing="5"><TextBlock Text="DOI" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="DoiBox"/></StackPanel>
            <StackPanel Spacing="5"><TextBlock Text="题名" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="TitleBox"/></StackPanel>
            <StackPanel Spacing="5"><TextBlock Text="作者（用 、 或 ; 分隔）" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="AuthorsBox"/></StackPanel>
            <StackPanel Spacing="5"><TextBlock Text="关键词（用 ； 或 ; 分隔）" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="KeywordsBox"/></StackPanel>
            <StackPanel Spacing="5"><TextBlock Text="来源 / 网址（可选）" FontWeight="SemiBold" FontSize="13"/><TextBox x:Name="SourceBox" PlaceholderText="例如 DOI 页面或数据库记录"/></StackPanel>
          </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="4,0" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Content="恢复自动提取" Classes="danger" Click="Reset_Click" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9">
          <Button Content="取消" Classes="secondary" Click="Cancel_Click" />
          <Button Content="保存修订" Classes="primary" Click="Save_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
