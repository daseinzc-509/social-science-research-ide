<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>SRA.Desktop</RootNamespace>
    <AssemblyName>SRA.Desktop</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationIcon>Assets\sra.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Explicitly embed App.axaml as an Avalonia XAML resource.
       The XAML class must be present in the compiled assembly before App.Initialize
       calls AvaloniaXamlLoader.Load(this). Remove it from the SDK's default XAML
       item list first to avoid a duplicate x:Class build error. -->
  <ItemGroup>
    <AvaloniaXaml Remove="App.axaml" />
    <AvaloniaResource Include="App.axaml" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
