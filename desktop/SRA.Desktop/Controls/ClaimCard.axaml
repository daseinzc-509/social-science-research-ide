<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SRA.Desktop.Models"
             x:Class="SRA.Desktop.Controls.ClaimCard"
             x:DataType="models:ClaimItem">
  <Border Classes="soft-card" Padding="14" Margin="0,0,0,10">
    <StackPanel Spacing="9">
      <WrapPanel ItemSpacing="6" LineSpacing="6">
        <Border Classes="badge-accent">
          <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
        </Border>
        <Border Classes="badge">
          <TextBlock Text="{Binding FieldLabel}" Classes="muted" FontSize="9" FontWeight="SemiBold" />
        </Border>
        <Border Classes="badge">
          <TextBlock Text="{Binding AuditLine}" Classes="muted" FontSize="9" />
        </Border>
      </WrapPanel>

      <TextBlock Text="{Binding Statement}" TextWrapping="Wrap" FontSize="13" LineHeight="20" />

      <Border IsVisible="{Binding HasScope}" Background="#F6F8F7" CornerRadius="7" Padding="9,7">
        <TextBlock Text="{Binding Scope}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
      </Border>

      <Border IsVisible="{Binding HasRationale}" Background="{StaticResource PurpleSoftBrush}" CornerRadius="8" Padding="10,8">
        <StackPanel Spacing="3">
          <TextBlock Text="审读理由" Foreground="{StaticResource PurpleInkBrush}" FontSize="9" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Rationale}" Foreground="{StaticResource PurpleInkBrush}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Evidence}" IsVisible="{Binding HasEvidence}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:EvidenceItem">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,2,0,0">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding MetaLine}" Foreground="{StaticResource BlueInkBrush}" FontSize="9" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Quote}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
